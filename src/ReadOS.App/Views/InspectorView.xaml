<UserControl
    x:Class="ReadOS.App.Views.InspectorView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MspTranscriptListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </UserControl.Resources>

    <Border DataContext="{Binding Inspector}"
            Style="{StaticResource ReadOSRightPaneStyle}">
        <Grid Padding="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid ColumnSpacing="{StaticResource SpacingSm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="Review Dock"
                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RuntimeStatusLabel}"
                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                               FontSize="{StaticResource FontSizeXs}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource ReadOSIconButtonStyle}"
                        ToolTipService.ToolTip="隐藏 Review Dock"
                        Command="{Binding ToggleInspectorCommand}">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE76C;"
                              FontSize="12" />
                </Button>
            </Grid>

            <!-- Tabs -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                    <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}" MinWidth="62"
                                  IsChecked="{Binding IsEvidenceInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Evidence"
                                  Content="证据" />
                    <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}" MinWidth="62"
                                  IsChecked="{Binding IsPreviewInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Preview"
                                  Content="预览" />
                    <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}" MinWidth="62"
                                  IsChecked="{Binding IsRunInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Run"
                                  Content="运行时" />
                    <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}" MinWidth="62"
                                  IsChecked="{Binding IsArtifactsInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Artifacts"
                                  Content="产物" />
                    <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}" MinWidth="62"
                                  IsChecked="{Binding IsPolicyInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Policy"
                                  Content="策略" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2">
                <!-- Evidence -->
                <ScrollViewer Visibility="{Binding IsEvidenceInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <Border Padding="12"
                                Style="{StaticResource ReadOSCardStyle}">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="当前上下文"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveTitle}"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding ActiveWorkspaceScope}"
                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextWrapping="WrapWholeWords" />
                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Height="32"
                                            Command="{Binding AttachCurrentPageCommand}"
                                            Content="附加本页" />
                                    <Button Grid.Column="1"
                                            Height="32"
                                            Command="{Binding StartRegionSelectionCommand}"
                                            Content="框选区域" />
                                </Grid>
                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Height="32"
                                             PlaceholderText="1-3, 8"
                                             Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Height="32"
                                            Padding="10,0"
                                            Command="{Binding AttachRangeCommand}"
                                            Content="附加范围" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="12"
                                Style="{StaticResource ReadOSCardStyle}">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="待发送证据"
                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PendingAttachmentSummary}"
                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Height="28"
                                            Padding="8,0"
                                            Command="{Binding ClearAttachmentsCommand}"
                                            Content="清空" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="9"
                                                    Style="{StaticResource ReadOSSubtleCardStyle}">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               FontSize="{StaticResource FontSizeSm}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                               FontSize="{StaticResource FontSizeSm}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Padding="12"
                                Style="{StaticResource ReadOSCardStyle}">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="目录"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                    <Button Height="30" Padding="8,0"
                                            Command="{Binding GenerateOutlineCommand}"
                                            Content="生成" />
                                    <Button Height="30" Padding="8,0"
                                            Command="{Binding AutoMapPagesCommand}"
                                            Content="映射页码" />
                                </StackPanel>
                                <ListView ItemsSource="{Binding Outline}"
                                          SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="180">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="4,4" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding IndentedTitle}"
                                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Page}"
                                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                           FontSize="{StaticResource FontSizeXs}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Grid ColumnSpacing="{StaticResource SpacingXs}"
                                      Visibility="{Binding HasSelectedOutlineWorkflowTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Height="30"
                                            Padding="8,0"
                                            ToolTipService.ToolTip="生成章节讲解工作流命令"
                                            Command="{Binding PrepareExplainSectionWorkflowCommand}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons"
                                                      Glyph="&#xE8F1;"
                                                      FontSize="12" />
                                            <TextBlock Text="讲解章节" />
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Height="30"
                                            Padding="8,0"
                                            ToolTipService.ToolTip="生成结构化证据抽取工作流命令"
                                            Command="{Binding PrepareExtractEvidenceWorkflowCommand}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons"
                                                      Glyph="&#xE8A5;"
                                                      FontSize="12" />
                                            <TextBlock Text="抽取证据" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid ColumnSpacing="{StaticResource SpacingXs}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox PlaceholderText="目录标题"
                                             Text="{Binding OutlineTitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Content="添加"
                                            Padding="8,6"
                                            Command="{Binding AddOutlineItemCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="12"
                                Style="{StaticResource ReadOSCardStyle}">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <Grid ColumnSpacing="{StaticResource SpacingXs}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox PlaceholderText="全文搜索"
                                             Text="{Binding DocumentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="1"
                                            Content="搜索"
                                            Padding="8,6"
                                            Command="{Binding SearchInDocumentCommand}" />
                                </Grid>
                                <ListView ItemsSource="{Binding DocumentSearchResults}"
                                          SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          MaxHeight="180">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="4,3">
                                                <TextBlock Text="{Binding PageNumber}"
                                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="{StaticResource FontSizeSm}" />
                                                <TextBlock Text="{Binding Preview}"
                                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           FontSize="{StaticResource FontSizeSm}"
                                                           MaxLines="3" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Preview -->
                <Grid Visibility="{Binding IsPreviewInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpacingXs}"
                                Margin="0,0,0,8">
                        <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="上一页"
                                Command="{Binding PreviousPageCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE76B;" FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                        <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="下一页"
                                Command="{Binding NextPageCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE76C;" FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                        <TextBox Width="64" Height="30"
                                 Text="{Binding PageJumpText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="页码" />
                        <Button Height="30" Padding="8,0"
                                Content="跳转"
                                Command="{Binding JumpToPageCommand}" />
                        <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="附加本页"
                                Command="{Binding AttachCurrentPageCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                        <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="框选证据"
                                Command="{Binding StartRegionSelectionCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEF20;" FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="{StaticResource SpacingMd}">
                            <Border Visibility="{Binding IsPresenterPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    MinHeight="220"
                                    Padding="20"
                                    Style="{StaticResource ReadOSComposerPanelStyle}">
                                <StackPanel Spacing="{StaticResource SpacingMd}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE8A5;"
                                              FontSize="24"
                                              Foreground="{ThemeResource ReadOSTextTertiaryBrush}" />
                                    <TextBlock Text="未打开资料"
                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeLg}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding PresenterKindLabel}"
                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                               FontSize="{StaticResource FontSizeSm}"
                                               HorizontalAlignment="Center" />
                                    <Button Content="导入资料"
                                            HorizontalAlignment="Center"
                                            Padding="12,6"
                                            Command="{Binding ImportMaterialCommand}" />
                                </StackPanel>
                            </Border>

                            <Grid Visibility="{Binding HasPageImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="{ThemeResource ReadOSPdfPageHostBrush}"
                                        Padding="8"
                                        CornerRadius="{StaticResource RadiusSm}">
                                    <Image x:Name="PdfPageImage"
                                           Source="{Binding CurrentPageImage}"
                                           Width="{Binding ReaderImageWidth}"
                                           Stretch="Uniform" />
                                </Border>
                                <Canvas x:Name="RegionCanvas"
                                        Background="Transparent"
                                        Visibility="{Binding IsRegionModeActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        PointerPressed="RegionCanvas_PointerPressed"
                                        PointerMoved="RegionCanvas_PointerMoved"
                                        PointerReleased="RegionCanvas_PointerReleased">
                                    <Rectangle x:Name="RegionRectangle"
                                               Visibility="Collapsed"
                                               Stroke="#FF3B30"
                                               StrokeThickness="3"
                                               Fill="#33FF3B30" />
                                </Canvas>
                            </Grid>

                            <TextBox Visibility="{Binding HasTextPresenter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     MinHeight="360"
                                     Padding="14"
                                     Background="{ThemeResource ReadOSCanvasBrush}"
                                     BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
                                     BorderThickness="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding PresenterTextContent, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Run -->
                <ScrollViewer Visibility="{Binding IsRunInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <Border Padding="12"
                                Style="{StaticResource ReadOSCardStyle}">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="Runtime Command"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Header="exec_command"
                                         PlaceholderText="workspace info"
                                         Text="{Binding MspCommandDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Height="32"
                                        Style="{StaticResource ReadOSPrimaryButtonStyle}"
                                        Command="{Binding RunMspCommandCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" FontSize="{StaticResource IconSizeSm}" />
                                        <TextBlock Text="执行 MSP 命令" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="{StaticResource SpacingSm}"
                                    Visibility="{Binding HasPreparedMspCommands, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Prepared commands"
                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                       FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding PreparedMspCommands}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Style="{StaticResource ReadOSCardStyle}">
                                            <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeSm}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding CreatedLabel}"
                                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextWrapping="Wrap"
                                                               MaxLines="3" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Width="30"
                                                        Height="30"
                                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                                        ToolTipService.ToolTip="恢复到命令输入框"
                                                        Command="{Binding DataContext.RestorePreparedMspCommandCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}">
                                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                                              Glyph="&#xE72C;"
                                                              FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Padding="12"
                                Style="{StaticResource ReadOSCardStyle}"
                                Visibility="{Binding HasSelectedMspTranscriptEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="Selected command"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedMspTranscriptEntry.CommandText}"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextWrapping="Wrap" />
                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedMspTranscriptEntry.StatusLabel}"
                                               Foreground="{ThemeResource ReadOSAccentBrush}"
                                               FontSize="{StaticResource FontSizeXs}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedMspTranscriptEntry.Decision}"
                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                               FontSize="{StaticResource FontSizeXs}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="{Binding SelectedMspTranscriptEntry.OutputPreview}"
                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="{StaticResource FontSizeXs}"
                                           TextWrapping="Wrap"
                                           MaxLines="8" />
                            </StackPanel>
                        </Border>

                        <ListView ItemsSource="{Binding MspTranscript}"
                                  SelectedItem="{Binding SelectedMspTranscriptEntry, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  IsTabStop="True"
                                  ItemContainerStyle="{StaticResource MspTranscriptListViewItemStyle}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Border Background="{ThemeResource ReadOSListSelectedBrush}"
                                                BorderBrush="{ThemeResource ReadOSAccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusLg}"
                                                Visibility="{Binding IsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Width="4"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource ReadOSAccentBrush}"
                                                CornerRadius="6,0,0,6"
                                                Visibility="{Binding IsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Margin="4,0,0,0"
                                                Padding="10"
                                                Style="{StaticResource ReadOSCardStyle}">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding CommandText}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeSm}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding StatusLabel}"
                                                               Foreground="{ThemeResource ReadOSAccentBrush}"
                                                               FontSize="{StaticResource FontSizeXs}" />
                                                </Grid>
                                                <TextBlock Text="{Binding OutputPreview}"
                                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                           FontFamily="Consolas"
                                                           FontSize="{StaticResource FontSizeXs}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="8" />
                                                <ProgressBar Height="4"
                                                             Value="{Binding ProgressPercentValue}"
                                                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                             Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource SpacingXs}">
                                                    <Button Height="26" Padding="8,0"
                                                            Visibility="{Binding IsApprovalRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Command="{Binding DataContext.ApproveMspCommandCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="批准并重放" />
                                                    <Button Height="26" Padding="8,0"
                                                            Visibility="{Binding IsApprovalRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Command="{Binding DataContext.DenyMspCommandCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="拒绝" />
                                                    <Button Height="26" Padding="8,0"
                                                            Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Command="{Binding DataContext.CancelMspCommandCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="取消" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!-- Artifacts -->
                <Grid Visibility="{Binding IsArtifactsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="170" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{Binding Artifacts}"
                              SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        Style="{StaticResource ReadOSCardStyle}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="1"
                                Margin="0,8,0,8"
                                Spacing="8">
                        <Grid ColumnSpacing="{StaticResource SpacingSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding ArtifactSummary}"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedArtifact.Path}"
                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="{StaticResource FontSizeXs}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingXs}">
                                <Button Width="32"
                                        Height="32"
                                        MinHeight="32"
                                        Padding="0"
                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                        ToolTipService.ToolTip="打开产物预览"
                                        Command="{Binding OpenSelectedArtifactPreviewCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE8A7;"
                                              FontSize="12" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        MinHeight="32"
                                        Padding="0"
                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                        ToolTipService.ToolTip="复制产物内容"
                                        Command="{Binding CopySelectedArtifactContentCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE8C8;"
                                              FontSize="12" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        MinHeight="32"
                                        Padding="0"
                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                        ToolTipService.ToolTip="导出产物"
                                        Command="{Binding ExportSelectedArtifactCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE896;"
                                              FontSize="12" />
                                </Button>
                                <Button Width="32"
                                        Height="32"
                                        MinHeight="32"
                                        Padding="0"
                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                        ToolTipService.ToolTip="把选中的 MSP 产物作为证据加入下一条消息"
                                        Command="{Binding AttachSelectedArtifactCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE710;"
                                              FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{StaticResource SpacingXs}"
                                    Visibility="{Binding HasSelectedArtifactWorkflowTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Height="30"
                                    Padding="8,0"
                                    ToolTipService.ToolTip="生成证据复核工作流命令"
                                    Command="{Binding PrepareReviewEvidenceWorkflowCommand}"
                                    Visibility="{Binding HasSelectedEvidenceArtifact, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE8D4;"
                                              FontSize="12" />
                                    <TextBlock Text="复核" />
                                </StackPanel>
                            </Button>
                            <Button Height="30"
                                    Padding="8,0"
                                    ToolTipService.ToolTip="生成证据综合工作流命令"
                                    Command="{Binding PrepareSynthesizeEvidenceWorkflowCommand}"
                                    Visibility="{Binding HasSelectedEvidenceArtifact, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE9D5;"
                                              FontSize="12" />
                                    <TextBlock Text="综合" />
                                </StackPanel>
                            </Button>
                            <Button Height="30"
                                    Padding="8,0"
                                    ToolTipService.ToolTip="生成产物精炼工作流命令"
                                    Command="{Binding PrepareRefineArtifactWorkflowCommand}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="6">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE70F;"
                                              FontSize="12" />
                                    <TextBlock Text="精炼" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,8"
                                Spacing="6"
                                Visibility="{Binding HasSelectedArtifactLineage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Source lineage"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeSm}"
                                   FontWeight="SemiBold" />
                        <ScrollViewer MaxHeight="150"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding SelectedArtifactLineage}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="8"
                                                Background="{ThemeResource ReadOSSubtleBrush}"
                                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMd}">
                                            <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28"
                                                        Height="28"
                                                        Style="{StaticResource ReadOSSubtleCardStyle}"
                                                        Padding="0">
                                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                                              Glyph="{Binding Glyph}"
                                                              FontSize="{StaticResource IconSizeSm}"
                                                              Foreground="{ThemeResource ReadOSAccentBrush}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1"
                                                            Spacing="1">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="{StaticResource SpacingXs}">
                                                        <Border Style="{StaticResource ReadOSChipStyle}">
                                                            <TextBlock Text="{Binding KindLabel}"
                                                                       Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                                       FontSize="{StaticResource FontSizeXs}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Path}"
                                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Visibility="{Binding HasDetail, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Width="28"
                                                        Height="28"
                                                        MinHeight="28"
                                                        Padding="0"
                                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                                        ToolTipService.ToolTip="打开来源产物"
                                                        Command="{Binding DataContext.OpenArtifactLineageItemCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding CanOpenArtifact, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                                              Glyph="&#xE8E5;"
                                                              FontSize="12" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <TextBox Grid.Row="3"
                             Header="{Binding SelectedArtifact.Path}"
                             Text="{Binding SelectedArtifactPreview, Mode=OneWay}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"
                             FontSize="{StaticResource FontSizeSm}"
                             Background="{ThemeResource ReadOSCanvasBrush}"
                             BorderBrush="{ThemeResource ReadOSBorderBrush}"
                             BorderThickness="1" />
                </Grid>

                <!-- Policy -->
                <ScrollViewer Visibility="{Binding IsPolicyInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <Border Padding="12"
                                Style="{StaticResource ReadOSCardStyle}">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="审批边界"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ApprovalModeLabel}"
                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ApprovalModeDetail}"
                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                           FontSize="{StaticResource FontSizeXs}"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal"
                                            Spacing="{StaticResource SpacingXs}">
                                    <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}"
                                                  MinWidth="62"
                                                  IsChecked="{Binding IsPolicyApprovalModeSelected, Mode=OneWay}"
                                                  Command="{Binding SelectApprovalModeCommand}"
                                                  CommandParameter="policy"
                                                  Content="策略" />
                                    <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}"
                                                  MinWidth="74"
                                                  IsChecked="{Binding IsConfirmAllApprovalModeSelected, Mode=OneWay}"
                                                  Command="{Binding SelectApprovalModeCommand}"
                                                  CommandParameter="confirm-all"
                                                  Content="每次确认" />
                                    <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}"
                                                  MinWidth="74"
                                                  IsChecked="{Binding IsAllowWorkspaceApprovalModeSelected, Mode=OneWay}"
                                                  Command="{Binding SelectApprovalModeCommand}"
                                                  CommandParameter="allow-workspace"
                                                  Content="允许写入" />
                                </StackPanel>
                                <TextBlock Text="{Binding PendingApprovalLabel}"
                                           Foreground="{ThemeResource ReadOSAccentBrush}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <Border Padding="12"
                                Style="{StaticResource ReadOSCardStyle}"
                                Visibility="{Binding HasSelectedMspTranscriptEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="Selected diagnostic"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedMspTranscriptEntry.CommandText}"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontFamily="Consolas"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedMspTranscriptEntry.Effects}"
                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                           FontSize="{StaticResource FontSizeXs}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedMspTranscriptEntry.DiagnosticsSummary}"
                                           Foreground="{ThemeResource ReadOSDangerBrush}"
                                           FontSize="{StaticResource FontSizeXs}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedMspTranscriptEntry.RecoveryHint}"
                                           Foreground="{ThemeResource ReadOSWarningBrush}"
                                           FontSize="{StaticResource FontSizeXs}"
                                           TextWrapping="Wrap" />
                                <Button Height="30"
                                        Padding="8,0"
                                        HorizontalAlignment="Left"
                                        ToolTipService.ToolTip="生成失败复查工作流命令"
                                        Command="{Binding PrepareReviewFailuresWorkflowCommand}"
                                        Visibility="{Binding HasSelectedFailureReviewTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE9D9;"
                                                  FontSize="12" />
                                        <TextBlock Text="生成复查" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <ListView ItemsSource="{Binding MspTranscript}"
                                  SelectedItem="{Binding SelectedMspTranscriptEntry, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                  IsTabStop="True"
                                  ItemContainerStyle="{StaticResource MspTranscriptListViewItemStyle}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Border Background="{ThemeResource ReadOSListSelectedBrush}"
                                                BorderBrush="{ThemeResource ReadOSAccentBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusLg}"
                                                Visibility="{Binding IsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Width="4"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource ReadOSAccentBrush}"
                                                CornerRadius="6,0,0,6"
                                                Visibility="{Binding IsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Border Margin="4,0,0,0"
                                                Padding="10"
                                                Style="{StaticResource ReadOSCardStyle}">
                                            <StackPanel Spacing="6">
                                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding CommandText}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeSm}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Decision}"
                                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                               FontSize="{StaticResource FontSizeXs}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Effects}"
                                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                           FontSize="{StaticResource FontSizeXs}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding PolicyPreview}"
                                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                           FontSize="{StaticResource FontSizeXs}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="8" />
                                                <TextBlock Text="{Binding RecoveryHint}"
                                                           Foreground="{ThemeResource ReadOSWarningBrush}"
                                                           FontSize="{StaticResource FontSizeXs}"
                                                           TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource SpacingXs}"
                                                            Visibility="{Binding IsApprovalRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Button Height="26" Padding="8,0"
                                                            Command="{Binding DataContext.ApproveMspCommandCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="批准并重放" />
                                                    <Button Height="26" Padding="8,0"
                                                            Command="{Binding DataContext.DenyMspCommandCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="拒绝" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>
