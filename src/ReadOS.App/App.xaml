                    <SolidColorBrush x:Key="ReadOSAccentMutedBrush" Color="#E5F3FF" />
                    <SolidColorBrush x:Key="ReadOSPrimaryButtonHoverBrush" Color="#0076E5" />
                    <SolidColorBrush x:Key="ReadOSPrimaryButtonPressedBrush" Color="#0067C8" />
                    <SolidColorBrush x:Key="ReadOSSuccessBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="ReadOSWarningBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="ReadOSDangerBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="ReadOSPdfPageHostBrush" Color="#D6DBE3" />
                    <SolidColorBrush x:Key="ReadOSSplitterHoverBrush" Color="#9CA3AF" />

                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#F0F1F3" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#1F2328" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#1F2328" />
