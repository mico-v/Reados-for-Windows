                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#DADDE3" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#C9CBD1" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#B8BBC4" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FFFFFF" />
