<UserControl
    x:Class="ReadOS.App.Views.InspectorView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border Background="{ThemeResource ReadOSSidebarBrush}"
            BorderBrush="{ThemeResource ReadOSBorderBrush}"
            BorderThickness="1,0,0,0">
        <Grid Padding="12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Header ────────────────────────────────────────────────── -->
            <Grid ColumnSpacing="{StaticResource SpacingSm}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="0" VerticalAlignment="Center">
                    <TextBlock Text="审查面板"
                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                               FontSize="{StaticResource FontSizeMd}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ActiveModelLabel}"
                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                               FontSize="{StaticResource FontSizeXs}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1"
                        Width="30" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        CornerRadius="6"
                        ToolTipService.ToolTip="隐藏审查面板"
                        Command="{Binding ToggleInspectorCommand}">
                    <FontIcon FontFamily="Segoe Fluent Icons"
                              Glyph="&#xE76C;"
                              FontSize="12" />
                </Button>
            </Grid>

            <!-- ── Tab bar ───────────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                    <ToggleButton Height="30" MinWidth="56"
                                  IsChecked="{Binding IsContextInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Context"
                                  Content="上下文" />
                    <ToggleButton Height="30" MinWidth="56"
                                  IsChecked="{Binding IsActionsInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Actions"
                                  Content="运行" />
                    <ToggleButton Height="30" MinWidth="56"
                                  IsChecked="{Binding IsEvidenceInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Evidence"
                                  Content="证据" />
                    <ToggleButton Height="30" MinWidth="56"
                                  IsChecked="{Binding IsAttachmentsInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Attachments"
                                  Content="附件" />
                    <!-- Preview tab — was the separate PresenterSurfaceView -->
                    <ToggleButton Height="30" MinWidth="56"
                                  IsChecked="{Binding IsPreviewInspectorSelected, Mode=OneWay}"
                                  Command="{Binding SelectInspectorTabCommand}"
                                  CommandParameter="Preview"
                                  Content="预览" />
                </StackPanel>
            </ScrollViewer>

            <!-- ── Tab content ───────────────────────────────────────────── -->
            <Grid Grid.Row="2">

                <!-- Context tab -->
                <ScrollViewer Visibility="{Binding IsContextInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <Border Padding="12"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{ThemeResource ReadOSRaisedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="当前对象"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveTitle}"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding ActiveSubtitle}"
                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                           FontSize="{StaticResource FontSizeSm}"
                                           TextWrapping="WrapWholeWords"
                                           MaxLines="4" />
                                <TextBox Header="名称"
                                         Text="{Binding DocumentNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Height="32"
                                            Command="{Binding RenameDocumentCommand}"
                                            Content="重命名" />
                                    <Button Grid.Column="1" Height="32"
                                            Command="{Binding DeleteDocumentCommand}"
                                            Content="删除" />
                                </Grid>
                                <Button Height="32"
                                        HorizontalAlignment="Stretch"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding OpenLocationCommand}"
                                        Content="打开位置" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{ThemeResource ReadOSRaisedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="工作区"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <Button Height="32" HorizontalAlignment="Stretch"
                                        Command="{Binding ExportWorkspaceCommand}"
                                        Content="导出工作区" />
                                <Button Height="32" HorizontalAlignment="Stretch"
                                        Command="{Binding ImportWorkspaceCommand}"
                                        Content="导入工作区" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Actions / MSP tab -->
                <ScrollViewer Visibility="{Binding IsActionsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <Border Padding="12"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{ThemeResource ReadOSRaisedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="MSP 命令"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Header="exec_command"
                                         PlaceholderText="workspace info"
                                         Text="{Binding MspCommandDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Height="32"
                                        HorizontalAlignment="Stretch"
                                        Background="{ThemeResource ReadOSAccentBrush}"
                                        Foreground="{ThemeResource ReadOSAccentTextBrush}"
                                        BorderThickness="0"
                                        Command="{Binding RunMspCommandCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE756;"
                                                  FontSize="{StaticResource IconSizeSm}" />
                                        <TextBlock Text="执行 MSP 命令" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                        <!-- Transcript -->
                        <Border Padding="12"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{ThemeResource ReadOSRaisedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <Grid RowSpacing="{StaticResource SpacingSm}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Transcript"
                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding MspTranscriptSummary}"
                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                               FontSize="{StaticResource FontSizeSm}" />
                                </StackPanel>
                                <ListView Grid.Row="1"
                                          MaxHeight="220"
                                          ItemsSource="{Binding MspTranscript}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6"
                                                    Padding="8"
                                                    CornerRadius="{StaticResource RadiusLg}"
                                                    Background="{ThemeResource ReadOSSubtleBrush}"
                                                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                    BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding CommandText}"
                                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="{StaticResource FontSizeSm}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding StatusLabel}"
                                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding OutputPreview}"
                                                               Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextWrapping="Wrap"
                                                               MaxLines="6" />
                                                    <Grid ColumnSpacing="{StaticResource SpacingSm}"
                                                          Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <ProgressBar Height="4"
                                                                     Value="{Binding ProgressPercentValue}"
                                                                     IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                                     VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Height="26" Padding="8,0"
                                                                Background="Transparent"
                                                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                                Command="{Binding DataContext.CancelMspCommandCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}"
                                                                ToolTipService.ToolTip="取消 MSP 命令">
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="{StaticResource SpacingXs}">
                                                                <FontIcon FontFamily="Segoe Fluent Icons"
                                                                          Glyph="&#xE711;"
                                                                          FontSize="10" />
                                                                <TextBlock Text="取消" FontSize="{StaticResource FontSizeXs}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="{Binding ArtifactsSummary}"
                                                               Foreground="{ThemeResource ReadOSAccentBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Effects}"
                                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="{StaticResource SpacingXs}"
                                                                Visibility="{Binding IsApprovalRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Button Height="26" Padding="8,0"
                                                                Command="{Binding DataContext.ApproveMspCommandCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="{StaticResource SpacingXs}">
                                                                <FontIcon FontFamily="Segoe Fluent Icons"
                                                                          Glyph="&#xE73E;"
                                                                          FontSize="10" />
                                                                <TextBlock Text="批准并重放" FontSize="{StaticResource FontSizeXs}" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Height="26" Padding="8,0"
                                                                Background="Transparent"
                                                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                                Command="{Binding DataContext.DenyMspCommandCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal"
                                                                        Spacing="{StaticResource SpacingXs}">
                                                                <FontIcon FontFamily="Segoe Fluent Icons"
                                                                          Glyph="&#xE711;"
                                                                          FontSize="10" />
                                                                <TextBlock Text="拒绝" FontSize="{StaticResource FontSizeXs}" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <!-- Task status + policy + thread controls -->
                                <StackPanel Grid.Row="2" Spacing="{StaticResource SpacingSm}">
                                    <Border Padding="8"
                                            CornerRadius="{StaticResource RadiusLg}"
                                            Background="{ThemeResource ReadOSSubtleBrush}"
                                            BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                            BorderThickness="1">
                                        <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressRing Width="16" Height="16"
                                                          IsActive="{Binding IsBusy}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StatusMessage}"
                                                       Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                       FontSize="{StaticResource FontSizeSm}"
                                                       TextWrapping="WrapWholeWords" />
                                        </Grid>
                                    </Border>
                                    <Border Padding="8"
                                            CornerRadius="{StaticResource RadiusLg}"
                                            Background="{ThemeResource ReadOSSubtleBrush}"
                                            BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="策略"
                                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                       FontSize="{StaticResource FontSizeSm}"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="确认模式"
                                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                       FontSize="{StaticResource FontSizeSm}"
                                                       TextWrapping="WrapWholeWords" />
                                        </StackPanel>
                                    </Border>
                                    <Button Height="32" HorizontalAlignment="Stretch"
                                            Command="{Binding NewConversationCommand}"
                                            Content="新建线程" />
                                    <Button Height="32" HorizontalAlignment="Stretch"
                                            Command="{Binding ClearConversationCommand}"
                                            Content="清空当前线程" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Evidence tab -->
                <ScrollViewer Visibility="{Binding IsEvidenceInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <Border Padding="12"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{ThemeResource ReadOSRaisedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="上下文摘要"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveWorkspaceScope}"
                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding PendingAttachmentSummary}"
                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                           FontSize="{StaticResource FontSizeSm}" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{ThemeResource ReadOSRaisedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="模型"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveModelLabel}"
                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                           TextWrapping="WrapWholeWords" />
                                <Button Height="32" HorizontalAlignment="Stretch"
                                        Command="{Binding NavigateSettingsCommand}"
                                        Content="模型设置" />
                            </StackPanel>
                        </Border>
                        <Border Padding="12"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{ThemeResource ReadOSRaisedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="文档搜索"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <TextBox Height="32"
                                         PlaceholderText="搜索当前文档"
                                         Text="{Binding DocumentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Height="32"
                                        Command="{Binding SearchInDocumentCommand}"
                                        Content="搜索" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Attachments tab -->
                <ScrollViewer Visibility="{Binding IsAttachmentsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="{StaticResource SpacingMd}">
                        <Border Padding="12"
                                CornerRadius="{StaticResource RadiusLg}"
                                Background="{ThemeResource ReadOSRaisedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="{StaticResource SpacingSm}">
                                <TextBlock Text="待发送证据"
                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                           FontWeight="SemiBold" />
                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Height="32"
                                            Command="{Binding AttachCurrentPageCommand}"
                                            Content="本页/全文" />
                                    <Button Grid.Column="1" Height="32"
                                            Command="{Binding StartRegionSelectionCommand}"
                                            Content="框选" />
                                </Grid>
                                <TextBox Height="32"
                                         PlaceholderText="1-3, 8"
                                         Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Height="32"
                                            Command="{Binding AttachRangeCommand}"
                                            Content="附加范围" />
                                    <Button Grid.Column="1" Height="32"
                                            Command="{Binding ClearAttachmentsCommand}"
                                            Content="清空" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ItemsControl ItemsSource="{Binding PendingAttachments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6"
                                            Padding="10"
                                            CornerRadius="{StaticResource RadiusLg}"
                                            Background="{ThemeResource ReadOSRaisedBrush}"
                                            BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                       FontSize="{StaticResource FontSizeSm}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}"
                                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                       FontSize="{StaticResource FontSizeSm}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Preview tab (was PresenterSurfaceView) -->
                <Grid Visibility="{Binding IsPreviewInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Preview toolbar -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Spacing="{StaticResource SpacingXs}"
                                Margin="0,0,0,8">
                        <Button Width="30" Height="30" Padding="0"
                                ToolTipService.ToolTip="上一页"
                                Command="{Binding PreviousPageCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE76B;"
                                      FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                        <Button Width="30" Height="30" Padding="0"
                                ToolTipService.ToolTip="下一页"
                                Command="{Binding NextPageCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE76C;"
                                      FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                        <TextBox Width="64" Height="30"
                                 Text="{Binding PageJumpText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="页码" />
                        <Button Height="30" Padding="8,0"
                                Content="跳转"
                                Command="{Binding JumpToPageCommand}" />
                        <Button Width="30" Height="30" Padding="0"
                                ToolTipService.ToolTip="附加本页"
                                Command="{Binding AttachCurrentPageCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE8A5;"
                                      FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                        <Button Width="30" Height="30" Padding="0"
                                ToolTipService.ToolTip="框选证据"
                                Command="{Binding StartRegionSelectionCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xEF20;"
                                      FontSize="{StaticResource IconSizeSm}" />
                        </Button>
                    </StackPanel>

                    <!-- Preview body -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="{StaticResource SpacingMd}">

                            <!-- Placeholder when no document open -->
                            <Border Visibility="{Binding IsPresenterPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    MinHeight="220"
                                    Padding="20"
                                    Background="{ThemeResource ReadOSCanvasBrush}"
                                    BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusLg}">
                                <StackPanel Spacing="{StaticResource SpacingMd}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE8A5;"
                                              FontSize="24"
                                              Foreground="{ThemeResource ReadOSTextTertiaryBrush}" />
                                    <TextBlock Text="未打开资料"
                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                               FontSize="{StaticResource FontSizeLg}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding PresenterKindLabel}"
                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                               FontSize="{StaticResource FontSizeSm}"
                                               HorizontalAlignment="Center" />
                                    <Button Content="导入资料"
                                            HorizontalAlignment="Center"
                                            Padding="12,6"
                                            Command="{Binding ImportMaterialCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- PDF page display -->
                            <Grid Visibility="{Binding HasPageImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="{ThemeResource ReadOSPdfPageHostBrush}"
                                        Padding="8"
                                        CornerRadius="{StaticResource RadiusSm}">
                                    <Image x:Name="PdfPageImage"
                                           Source="{Binding CurrentPageImage}"
                                           Width="{Binding ReaderImageWidth}"
                                           Stretch="Uniform" />
                                </Border>
                                <Canvas x:Name="RegionCanvas"
                                        Background="Transparent"
                                        Visibility="{Binding IsRegionModeActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        PointerPressed="RegionCanvas_PointerPressed"
                                        PointerMoved="RegionCanvas_PointerMoved"
                                        PointerReleased="RegionCanvas_PointerReleased">
                                    <Rectangle x:Name="RegionRectangle"
                                               Visibility="Collapsed"
                                               Stroke="#FF3B30"
                                               StrokeThickness="3"
                                               Fill="#33FF3B30" />
                                </Canvas>
                            </Grid>

                            <!-- Text / Markdown display -->
                            <TextBox Visibility="{Binding HasTextPresenter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     MinHeight="360"
                                     Padding="14"
                                     Background="{ThemeResource ReadOSCanvasBrush}"
                                     BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
                                     BorderThickness="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding PresenterTextContent, Mode=OneWay}" />

                            <!-- Outline section (below preview) -->
                            <Border Padding="12"
                                    CornerRadius="{StaticResource RadiusLg}"
                                    Background="{ThemeResource ReadOSRaisedBrush}"
                                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="{StaticResource SpacingSm}">
                                    <TextBlock Text="目录"
                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{StaticResource SpacingXs}">
                                        <Button Height="30" Padding="8,0"
                                                Command="{Binding GenerateOutlineCommand}"
                                                Content="生成" />
                                        <Button Height="30" Padding="8,0"
                                                Command="{Binding AutoMapPagesCommand}"
                                                Content="映射" />
                                    </StackPanel>
                                    <ListView ItemsSource="{Binding Outline}"
                                              SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              MaxHeight="180">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Padding="4,4" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding IndentedTitle}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Page}"
                                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                               FontSize="{StaticResource FontSizeXs}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Grid ColumnSpacing="{StaticResource SpacingXs}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="目录标题"
                                                 Text="{Binding OutlineTitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1"
                                                Content="添加" Padding="8,6"
                                                Command="{Binding AddOutlineItemCommand}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Search results -->
                            <Border Padding="12"
                                    CornerRadius="{StaticResource RadiusLg}"
                                    Background="{ThemeResource ReadOSRaisedBrush}"
                                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="{StaticResource SpacingSm}">
                                    <Grid ColumnSpacing="{StaticResource SpacingXs}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox PlaceholderText="全文搜索"
                                                 Text="{Binding DocumentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1"
                                                Content="搜索" Padding="8,6"
                                                Command="{Binding SearchInDocumentCommand}" />
                                    </Grid>
                                    <ListView ItemsSource="{Binding DocumentSearchResults}"
                                              SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              MaxHeight="180">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Padding="4,3">
                                                    <TextBlock Text="{Binding PageNumber}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="{StaticResource FontSizeSm}" />
                                                    <TextBlock Text="{Binding Preview}"
                                                               Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               FontSize="{StaticResource FontSizeSm}"
                                                               MaxLines="3" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
