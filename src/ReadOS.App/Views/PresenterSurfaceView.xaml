<UserControl
    x:Class="ReadOS.App.Views.PresenterSurfaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Border Background="{ThemeResource ReadOSSubtleBrush}"
            BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="12,0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="证据预览" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding CurrentPageIndicator}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="回到对话" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="FocusChat">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BD;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="并排显示" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="PresenterPrimary">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A9;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="专注预览" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="FocusPresenter">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="材料导航" Command="{Binding ToggleThumbnailsCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7C3;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="附加本页或全文" Command="{Binding AttachCurrentPageCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="框选证据" Command="{Binding StartRegionSelectionCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEF20;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PresenterThumbnailColumn" Width="148" />
                    <ColumnDefinition x:Name="PresenterDrawerSplitterColumn" Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource ReadOSSidebarBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,1,0">
                    <Grid Padding="10" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="150" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="132" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="材料" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="隐藏" Command="{Binding ToggleThumbnailsCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BB;" FontSize="12" />
                            </Button>
                        </Grid>

                        <ListView Grid.Row="1"
                                  ItemsSource="{Binding Thumbnails}"
                                  SelectedItem="{Binding SelectedThumbnail, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4" Margin="0,0,0,8">
                                        <Border Background="{ThemeResource ReadOSCanvasBrush}" Padding="3" BorderBrush="{ThemeResource ReadOSStrongBorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Image Source="{Binding Image}" Width="92" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" FontSize="11" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Grid.Row="2" Spacing="8">
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="页码" Text="{Binding PageJumpText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="跳转" Padding="8,6" Command="{Binding JumpToPageCommand}" />
                            </Grid>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Height="32" Command="{Binding PreviousPageCommand}" Content="上一页" />
                                <Button Grid.Column="1" Height="32" Command="{Binding NextPageCommand}" Content="下一页" />
                            </Grid>
                            <Slider Minimum="420" Maximum="1280" Value="{Binding ReaderImageWidth, Mode=TwoWay}" />
                        </StackPanel>

                        <Grid Grid.Row="3" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Height="32" Padding="8,0" Command="{Binding GenerateOutlineCommand}" Content="生成" />
                                <Button Height="32" Padding="8,0" Command="{Binding AutoMapPagesCommand}" Content="映射" />
                            </StackPanel>
                            <ListView Grid.Row="1" ItemsSource="{Binding Outline}" SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,5" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding IndentedTitle}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Page}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Grid Grid.Row="2" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="目录标题" Text="{Binding OutlineTitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="添加" Padding="8,6" Command="{Binding AddOutlineItemCommand}" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="4" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="全文搜索" Text="{Binding DocumentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="搜索" Padding="8,6" Command="{Binding SearchInDocumentCommand}" />
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{Binding DocumentSearchResults}" SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="4,4">
                                            <TextBlock Text="{Binding PageNumber}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                                            <TextBlock Text="{Binding Preview}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" MaxLines="3" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Column="1" Background="Transparent">
                    <Rectangle Width="1" Fill="{ThemeResource ReadOSBorderBrush}" HorizontalAlignment="Center" />
                    <primitives:Thumb Width="12" HorizontalAlignment="Center" Background="Transparent" DragDelta="PresenterDrawerResizeThumb_DragDelta" />
                </Grid>

                <Grid Grid.Column="2" Background="{ThemeResource ReadOSSubtleBrush}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid Padding="22" HorizontalAlignment="Center">
                            <Border Visibility="{Binding IsPresenterPlaceholderVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Width="460"
                                    MinHeight="320"
                                    Padding="26"
                                    Background="{ThemeResource ReadOSCanvasBrush}"
                                    BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="30" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" />
                                    <TextBlock Text="未打开资料" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding PresenterKindLabel}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                                    <Button Content="导入资料" HorizontalAlignment="Center" Padding="14,8" Command="{Binding ImportMaterialCommand}" />
                                </StackPanel>
                            </Border>

                            <Grid Visibility="{Binding HasPageImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Background="{ThemeResource ReadOSPdfPageHostBrush}" Padding="10" CornerRadius="4">
                                    <Image x:Name="PdfPageImage"
                                           Source="{Binding CurrentPageImage}"
                                           Width="{Binding ReaderImageWidth}"
                                           Stretch="Uniform" />
                                </Border>
                                <Canvas x:Name="RegionCanvas"
                                        Background="Transparent"
                                        Visibility="{Binding IsRegionModeActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        PointerPressed="RegionCanvas_PointerPressed"
                                        PointerMoved="RegionCanvas_PointerMoved"
                                        PointerReleased="RegionCanvas_PointerReleased">
                                    <Rectangle x:Name="RegionRectangle"
                                               Visibility="Collapsed"
                                               Stroke="#FF3B30"
                                               StrokeThickness="3"
                                               Fill="#33FF3B30" />
                                </Canvas>
                            </Grid>

                            <TextBox Visibility="{Binding HasTextPresenter, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Width="760"
                                     MinHeight="520"
                                     Padding="18"
                                     Background="{ThemeResource ReadOSCanvasBrush}"
                                     BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
                                     BorderThickness="1"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Text="{Binding PresenterTextContent, Mode=OneWay}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
