<UserControl
    x:Class="ReadOS.App.Views.ChatSurfaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border DataContext="{Binding Thread}"
            Background="{ThemeResource ReadOSCanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Thread header -->
            <Border Style="{StaticResource ReadOSPaneToolbarStyle}"
                    Padding="14,0">
                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTitle}"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeMd}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <TextBlock Text="{Binding ActiveWorkspaceScope}"
                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="·"
                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                       FontSize="{StaticResource FontSizeXs}" />
                            <TextBlock Text="{Binding MspActivitySummary}"
                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <Border Style="{StaticResource ReadOSChipStyle}">
                            <TextBlock Text="{Binding RuntimeStatusLabel}"
                                       Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                       FontSize="{StaticResource FontSizeXs}" />
                        </Border>
                        <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="显示侧栏"
                                Click="RestoreSidebarButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE700;"
                                      FontSize="12" />
                        </Button>
                        <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="显示 Review Dock"
                                Click="RestoreInspectorButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE76B;"
                                      FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Thread body -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Padding="24,18">
                    <ItemsControl ItemsSource="{Binding TimelineItems}"
                                  MaxWidth="960"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="28" Height="28"
                                            Style="{StaticResource ReadOSSubtleCardStyle}"
                                            Padding="0"
                                            VerticalAlignment="Top">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="{Binding Glyph}"
                                                  FontSize="{StaticResource IconSizeSm}"
                                                  Foreground="{ThemeResource ReadOSAccentBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>

                                    <Border Grid.Column="1"
                                            Padding="12"
                                            Style="{StaticResource ReadOSCardStyle}">
                                        <StackPanel Spacing="9">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Border Style="{StaticResource ReadOSChipStyle}">
                                                                <TextBlock Text="{Binding KindLabel}"
                                                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                                           FontSize="{StaticResource FontSizeXs}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding Title}"
                                                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Timestamp}"
                                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                           FontSize="{StaticResource FontSizeXs}"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Attachments}"
                                                          Visibility="{Binding HasAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6"
                                                                Padding="8"
                                                                Style="{StaticResource ReadOSSubtleCardStyle}">
                                                            <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon FontFamily="Segoe Fluent Icons"
                                                                          Glyph="&#xE8A5;"
                                                                          FontSize="{StaticResource IconSizeSm}"
                                                                          Foreground="{ThemeResource ReadOSAccentBrush}"
                                                                          VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Spacing="1">
                                                                    <TextBlock Text="{Binding Title}"
                                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                               FontSize="{StaticResource FontSizeSm}"
                                                                               FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Detail}"
                                                                               Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                                               FontSize="{StaticResource FontSizeSm}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock Text="{Binding Body}"
                                                       Visibility="{Binding HasMessageBody, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                       TextWrapping="WrapWholeWords"
                                                       LineHeight="21" />

                                            <Border Visibility="{Binding HasEvidenceBody, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Padding="9"
                                                    Background="{ThemeResource ReadOSAccentMutedBrush}"
                                                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="Evidence"
                                                               Foreground="{ThemeResource ReadOSAccentBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Body}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               TextWrapping="WrapWholeWords"
                                                               LineHeight="21" />
                                                    <Button Height="28" Padding="8,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.OpenTimelineItemCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="打开证据" />
                                                </StackPanel>
                                            </Border>

                                            <Border Visibility="{Binding IsMspApproval, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Padding="9"
                                                    Background="{ThemeResource ReadOSAccentMutedBrush}"
                                                    BorderBrush="{ThemeResource ReadOSAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}">
                                                <StackPanel Spacing="7">
                                                    <TextBlock Text="{Binding MspEntry.CommandText}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeSm}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MspEntry.PolicyPreview}"
                                                               Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasPolicyPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                                        <Button Height="28" Padding="8,0"
                                                                Command="{Binding DataContext.ApproveMspCommandCommand, ElementName=Root}"
                                                                CommandParameter="{Binding MspEntry}"
                                                                Content="批准并重放" />
                                                        <Button Height="28" Padding="8,0"
                                                                Command="{Binding DataContext.DenyMspCommandCommand, ElementName=Root}"
                                                                CommandParameter="{Binding MspEntry}"
                                                                Content="拒绝" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Visibility="{Binding IsMspRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Padding="9"
                                                    Background="{ThemeResource ReadOSSubtleBrush}"
                                                    BorderBrush="{ThemeResource ReadOSAccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}">
                                                <StackPanel Spacing="7">
                                                    <TextBlock Text="{Binding MspEntry.CommandText}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeSm}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ProgressBar Height="4"
                                                                 Value="{Binding MspEntry.ProgressPercentValue}"
                                                                 IsIndeterminate="{Binding MspEntry.IsProgressIndeterminate}" />
                                                    <TextBlock Text="{Binding MspEntry.OutputPreview}"
                                                               Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextWrapping="Wrap"
                                                               MaxLines="5" />
                                                    <Button Height="28" Padding="8,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.CancelMspCommandCommand, ElementName=Root}"
                                                            CommandParameter="{Binding MspEntry}"
                                                            Content="取消" />
                                                </StackPanel>
                                            </Border>

                                            <Border Visibility="{Binding IsMspResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Padding="9"
                                                    Background="{ThemeResource ReadOSSubtleBrush}"
                                                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}">
                                                <StackPanel Spacing="7">
                                                    <TextBlock Text="{Binding MspEntry.CommandText}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeSm}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MspEntry.OutputPreview}"
                                                               Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextWrapping="Wrap"
                                                               MaxLines="8" />
                                                    <TextBlock Text="{Binding MspEntry.ArtifactsSummary}"
                                                               Foreground="{ThemeResource ReadOSAccentBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasArtifactsSummary, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Button Height="28" Padding="8,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.OpenTimelineItemCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="查看运行" />
                                                </StackPanel>
                                            </Border>

                                            <Border Visibility="{Binding IsMspError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Padding="9"
                                                    Background="{ThemeResource ReadOSSubtleBrush}"
                                                    BorderBrush="{ThemeResource ReadOSDangerBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}">
                                                <StackPanel Spacing="7">
                                                    <TextBlock Text="{Binding MspEntry.CommandText}"
                                                               Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                               FontFamily="Consolas"
                                                               FontSize="{StaticResource FontSizeSm}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MspEntry.DiagnosticsSummary}"
                                                               Foreground="{ThemeResource ReadOSDangerBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasDiagnostics, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Text="{Binding MspEntry.RecoveryHint}"
                                                               Foreground="{ThemeResource ReadOSWarningBrush}"
                                                               FontSize="{StaticResource FontSizeXs}"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasRecoveryHint, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <Button Height="28" Padding="8,0"
                                                            HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.OpenTimelineItemCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="查看诊断" />
                                                </StackPanel>
                                            </Border>

                                            <Border Visibility="{Binding HasArtifact, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Padding="9"
                                                    Style="{StaticResource ReadOSSubtleCardStyle}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Artifact.Path}"
                                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="{StaticResource FontSizeSm}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Artifact.Description}"
                                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Height="28"
                                                            Padding="8,0"
                                                            Command="{Binding DataContext.OpenTimelineItemCommand, ElementName=Root}"
                                                            CommandParameter="{Binding}"
                                                            Content="打开" />
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Composer -->
                <Border Grid.Row="1"
                        Margin="14,0,14,14"
                        Padding="10"
                        Style="{StaticResource ReadOSComposerPanelStyle}">
                    <Grid RowSpacing="{StaticResource SpacingSm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="{StaticResource SpacingSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                    <Border Style="{StaticResource ReadOSChipStyle}">
                                        <TextBlock Text="{Binding PendingAttachmentSummary}"
                                                   Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding PendingAttachments}"
                                                  Visibility="{Binding HasPendingAttachments, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource SpacingXs}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="7,4"
                                                        CornerRadius="{StaticResource RadiusMd}"
                                                        Background="{ThemeResource ReadOSAccentMutedBrush}"
                                                        BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                        BorderThickness="1">
                                                    <Grid ColumnSpacing="{StaticResource SpacingXs}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   FontWeight="SemiBold"
                                                                   MaxWidth="180"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Detail}"
                                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   MaxWidth="120"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="2"
                                                                Width="20"
                                                                Height="20"
                                                                MinHeight="20"
                                                                Padding="0"
                                                                Style="{StaticResource ReadOSIconButtonStyle}"
                                                                ToolTipService.ToolTip="移除此附件"
                                                                Command="{Binding DataContext.RemovePendingAttachmentCommand, ElementName=Root}"
                                                                CommandParameter="{Binding}">
                                                            <FontIcon FontFamily="Segoe Fluent Icons"
                                                                      Glyph="&#xE711;"
                                                                      FontSize="9" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding QueuedComposerPrompts}"
                                                  Visibility="{Binding HasQueuedComposerPrompts, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="{StaticResource SpacingXs}" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Height="28"
                                                        Padding="8,0"
                                                        Background="{ThemeResource ReadOSSubtleBrush}"
                                                        BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                        ToolTipService.ToolTip="恢复此队列项"
                                                        Command="{Binding DataContext.RestoreQueuedComposerPromptCommand, ElementName=Root}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="{StaticResource SpacingXs}">
                                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                                  Glyph="&#xE8FD;"
                                                                  FontSize="{StaticResource IconSizeSm}"
                                                                  Foreground="{ThemeResource ReadOSAccentBrush}" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   FontWeight="SemiBold"
                                                                   MaxWidth="160"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                                   FontSize="{StaticResource FontSizeXs}"
                                                                   MaxWidth="90"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{StaticResource SpacingXs}"
                                                ToolTipService.ToolTip="{Binding ApprovalModeDetail}">
                                        <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}"
                                                      MinWidth="50"
                                                      IsChecked="{Binding IsPolicyApprovalModeSelected, Mode=OneWay}"
                                                      Command="{Binding SelectApprovalModeCommand}"
                                                      CommandParameter="policy"
                                                      Content="策略" />
                                        <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}"
                                                      MinWidth="64"
                                                      IsChecked="{Binding IsConfirmAllApprovalModeSelected, Mode=OneWay}"
                                                      Command="{Binding SelectApprovalModeCommand}"
                                                      CommandParameter="confirm-all"
                                                      Content="每次确认" />
                                        <ToggleButton Style="{StaticResource ReadOSSegmentButtonStyle}"
                                                      MinWidth="64"
                                                      IsChecked="{Binding IsAllowWorkspaceApprovalModeSelected, Mode=OneWay}"
                                                      Command="{Binding SelectApprovalModeCommand}"
                                                      CommandParameter="allow-workspace"
                                                      Content="允许写入" />
                                    </StackPanel>
                                    <Border Style="{StaticResource ReadOSChipStyle}">
                                        <TextBlock Text="{Binding RuntimeStatusLabel}"
                                                   Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}" />
                                    </Border>
                                    <Button Height="28"
                                            Padding="8,0"
                                            Background="{ThemeResource ReadOSAccentMutedBrush}"
                                            BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                            ToolTipService.ToolTip="打开待审批 MSP 命令"
                                            Command="{Binding OpenPendingApprovalCommand}"
                                            Visibility="{Binding HasPendingApprovals, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="{StaticResource SpacingXs}">
                                            <FontIcon FontFamily="Segoe Fluent Icons"
                                                      Glyph="&#xE7BA;"
                                                      FontSize="{StaticResource IconSizeSm}"
                                                      Foreground="{ThemeResource ReadOSAccentBrush}" />
                                            <TextBlock Text="{Binding PendingApprovalLabel}"
                                                       Foreground="{ThemeResource ReadOSAccentBrush}"
                                                       FontSize="{StaticResource FontSizeXs}"
                                                       FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ReadOSIconButtonStyle}"
                                    ToolTipService.ToolTip="清空附件"
                                    Command="{Binding ClearAttachmentsCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE74D;"
                                          FontSize="{StaticResource IconSizeSm}" />
                            </Button>
                        </Grid>

                        <TextBox Grid.Row="1"
                                 MinHeight="76"
                                 MaxHeight="160"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 PlaceholderText="让 ReadOS 执行阅读、证据或 MSP 任务..."
                                 Text="{Binding ComposerDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource SpacingSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                <Button Width="32" Height="32" Padding="0"
                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                        ToolTipService.ToolTip="附加当前页或全文"
                                        Command="{Binding AttachCurrentPageCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE8A5;"
                                              FontSize="{StaticResource IconSizeSm}" />
                                </Button>
                                <Button Width="32" Height="32" Padding="0"
                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                        ToolTipService.ToolTip="框选证据"
                                        Command="{Binding StartRegionSelectionCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xEF20;"
                                              FontSize="{StaticResource IconSizeSm}" />
                                </Button>
                                <TextBox Width="120" Height="32"
                                         PlaceholderText="1-3, 8"
                                         Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Height="32" Padding="10,0"
                                        Style="{StaticResource ReadOSGhostButtonStyle}"
                                        Command="{Binding AttachRangeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE8A5;"
                                                  FontSize="{StaticResource IconSizeSm}" />
                                        <TextBlock Text="范围" />
                                    </StackPanel>
                                </Button>
                                <Button Width="32" Height="32" Padding="0"
                                        Style="{StaticResource ReadOSIconButtonStyle}"
                                        ToolTipService.ToolTip="显示 Runtime Drawer"
                                        Command="{Binding ToggleRunDrawerCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE756;"
                                              FontSize="{StaticResource IconSizeSm}" />
                                </Button>
                                <Button Height="32" Padding="10,0"
                                        Style="{StaticResource ReadOSGhostButtonStyle}"
                                        ToolTipService.ToolTip="用当前输入精炼选中的产物"
                                        Command="{Binding PrepareComposerArtifactRefinementWorkflowCommand}"
                                        Visibility="{Binding HasComposerArtifactRefinementTarget, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{StaticResource SpacingXs}">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE70F;"
                                                  FontSize="{StaticResource IconSizeSm}" />
                                        <TextBlock Text="精炼" />
                                    </StackPanel>
                                </Button>
                                <Button Height="32" Padding="10,0"
                                        Style="{StaticResource ReadOSGhostButtonStyle}"
                                        ToolTipService.ToolTip="将当前草稿和证据加入队列"
                                        Command="{Binding QueueComposerDraftCommand}"
                                        Visibility="{Binding IsAnyMspRunning, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{StaticResource SpacingXs}">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE8FD;"
                                                  FontSize="{StaticResource IconSizeSm}" />
                                        <TextBlock Text="队列" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Height="32" MinWidth="84" Padding="12,0"
                                    Style="{StaticResource ReadOSPrimaryButtonStyle}"
                                    ToolTipService.ToolTip="{Binding ComposerPrimaryToolTip}"
                                    Command="{Binding ComposerPrimaryCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                    <TextBlock Text="{Binding SendButtonLabel}" FontWeight="SemiBold" />
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="{Binding ComposerPrimaryGlyph}"
                                              FontSize="{StaticResource IconSizeSm}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
