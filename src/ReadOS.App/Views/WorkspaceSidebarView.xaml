<UserControl
    x:Class="ReadOS.App.Views.WorkspaceSidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border DataContext="{Binding Sidebar}"
            Style="{StaticResource ReadOSLeftPaneStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource ReadOSChromeBrush}"
                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid Padding="6,8">
                        <StackPanel Spacing="{StaticResource SpacingSm}"
                                VerticalAlignment="Top"
                                Margin="0,4,0,0">
                        <ToggleButton Style="{StaticResource ReadOSRailButtonStyle}"
                                      IsChecked="{Binding IsConversationsSidebarSelected, Mode=OneWay}"
                                      ToolTipService.ToolTip="线程"
                                      Command="{Binding SelectSidebarModeCommand}"
                                      CommandParameter="Conversations">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE8BD;"
                                      FontSize="{StaticResource IconSizeMd}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ReadOSRailButtonStyle}"
                                      IsChecked="{Binding IsMaterialsSidebarSelected, Mode=OneWay}"
                                      ToolTipService.ToolTip="资料"
                                      Command="{Binding SelectSidebarModeCommand}"
                                      CommandParameter="Materials">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE8A5;"
                                      FontSize="{StaticResource IconSizeMd}" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ReadOSRailButtonStyle}"
                                      IsChecked="{Binding IsSessionsSidebarSelected, Mode=OneWay}"
                                      ToolTipService.ToolTip="MSP 会话"
                                      Command="{Binding SelectSidebarModeCommand}"
                                      CommandParameter="Sessions">
                            <Grid Width="24"
                                  Height="24">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE756;"
                                          FontSize="{StaticResource IconSizeMd}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                <Ellipse Width="8"
                                         Height="8"
                                         Fill="{ThemeResource ReadOSWarningBrush}"
                                         Stroke="{ThemeResource ReadOSChromeBrush}"
                                         StrokeThickness="1"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Top"
                                         Visibility="{Binding HasPendingApprovals, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ReadOSRailButtonStyle}"
                                      IsChecked="{Binding IsArtifactsSidebarSelected, Mode=OneWay}"
                                      ToolTipService.ToolTip="产物"
                                      Command="{Binding SelectSidebarModeCommand}"
                                      CommandParameter="Artifacts">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE8A5;"
                                      FontSize="{StaticResource IconSizeMd}" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  Padding="12"
                  RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="{StaticResource SpacingSm}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="1"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsConversationsSidebarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Threads"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RuntimeStatusLabel}"
                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Spacing="1"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsMaterialsSidebarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Materials"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LibrarySummary}"
                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Spacing="1"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsSessionsSidebarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="MSP Sessions"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MspActivitySummary}"
                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Spacing="1"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsArtifactsSidebarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Artifacts"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeLg}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ArtifactSummary}"
                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="隐藏左侧面板"
                            Command="{Binding ToggleSidebarCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE76B;"
                                  FontSize="{StaticResource IconSizeSm}" />
                    </Button>
                </Grid>

                <TextBox Grid.Row="1"
                         Height="34"
                         PlaceholderText="搜索当前工作上下文"
                         Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Grid Grid.Row="2">
                    <ListView ItemsSource="{Binding Conversations}"
                              SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              Visibility="{Binding IsConversationsSidebarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8"
                                      ColumnSpacing="9"
                                      MinHeight="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="7"
                                             Height="7"
                                             Fill="{ThemeResource ReadOSAccentBrush}"
                                             VerticalAlignment="Top"
                                             Margin="0,7,0,0" />
                                    <StackPanel Grid.Column="1"
                                                Spacing="3">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UpdatedAt}"
                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView ItemsSource="{Binding NavigationEntries}"
                              SelectedItem="{Binding SelectedNavigationEntry, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              Visibility="{Binding IsMaterialsSidebarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8"
                                      ColumnSpacing="{StaticResource SpacingSm}"
                                      MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30"
                                            Height="30"
                                            Style="{StaticResource ReadOSSubtleCardStyle}"
                                            Padding="0">
                                        <TextBlock Text="{Binding Prefix}"
                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView ItemsSource="{Binding MspSessions}"
                              SelectedItem="{Binding SelectedMspSession, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              Visibility="{Binding IsSessionsSidebarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8"
                                      ColumnSpacing="{StaticResource SpacingSm}"
                                      MinHeight="64">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30"
                                            Height="30"
                                            Style="{StaticResource ReadOSSubtleCardStyle}"
                                            Padding="0">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="{Binding StatusGlyph}"
                                                  FontSize="{StaticResource IconSizeSm}"
                                                  Foreground="{ThemeResource ReadOSAccentBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Spacing="2">
                                        <Grid ColumnSpacing="{StaticResource SpacingXs}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1"
                                                    Padding="6,2"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Background="{ThemeResource ReadOSAccentMutedBrush}"
                                                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                    BorderThickness="1">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           Foreground="{ThemeResource ReadOSAccentBrush}"
                                                           FontSize="{StaticResource FontSizeXs}"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Summary}"
                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastCommandText}"
                                                   Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ListView ItemsSource="{Binding Artifacts}"
                              SelectedItem="{Binding SelectedArtifact, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single"
                              Visibility="{Binding IsArtifactsSidebarSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8"
                                      ColumnSpacing="{StaticResource SpacingSm}"
                                      MinHeight="62">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30"
                                            Height="30"
                                            Style="{StaticResource ReadOSSubtleCardStyle}"
                                            Padding="0">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE8A5;"
                                                  FontSize="{StaticResource IconSizeSm}"
                                                  Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Spacing="2">
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="{StaticResource FontSizeSm}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}"
                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                   FontSize="{StaticResource FontSizeXs}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Border Grid.Row="3"
                        Style="{StaticResource ReadOSSubtleCardStyle}"
                        Padding="10">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding MspActivitySummary}"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeXs}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding PendingApprovalLabel}"
                                   Foreground="{ThemeResource ReadOSWarningBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasPendingApprovals, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding ArtifactSummary}"
                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
