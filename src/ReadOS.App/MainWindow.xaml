<Window
    x:Class="ReadOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:ReadOS.App.Views"
    mc:Ignorable="d"
    Title="ReadOS">

    <!--
        MSP workbench shell: left workspace sidebar | active chat thread | unified
        review dock, plus a collapsible bottom Runtime Drawer for command
        supervision (resizable height, persisted height/pin state). The thread is
        the primary work narrative; the inspector reacts to selected evidence,
        commands, approvals, and artifacts.
    -->

    <Grid x:Name="RootShell" Background="{ThemeResource MspAppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 0 — Minimal top bar
             Brand · new thread · theme · settings · model/status chip.
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource MspAppBackgroundBrush}"
                BorderBrush="{ThemeResource MspDividerBrush}"
                BorderThickness="0,0,0,1">
            <Grid Padding="12,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: brand + new thread -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            CornerRadius="{StaticResource MspBubbleRadius}"
                            Background="{ThemeResource MspAssistantAccentBrush}">
                        <TextBlock Text="R"
                                   Foreground="{ThemeResource ReadOSBrandTextBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="新建线程"
                            Command="{Binding NewConversationCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE710;"
                                  FontSize="13" />
                    </Button>

                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="对话历史"
                            Command="{Binding OpenHistoryFlyoutCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE81C;"
                                  FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- Center: drag region -->
                <Grid Grid.Column="1"
                      x:Name="TitleBarDragRegion"
                      Background="Transparent" />

                <!-- Right: theme · settings · status chip -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="待审批 MSP 命令"
                            Command="{Binding OpenApprovalsFlyoutCommand}"
                            Visibility="{Binding HasPendingApprovals, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE7E7;"
                                      FontSize="13" />
                            <Border Background="{ThemeResource MspAssistantAccentBrush}"
                                    MinWidth="16" Height="16" CornerRadius="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="6,-4,0,0"
                                    Visibility="{Binding HasPendingApprovals, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding PendingApprovalCount}"
                                           Foreground="{ThemeResource ReadOSBrandTextBrush}"
                                           FontSize="9" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Background="Transparent" Padding="0" BorderThickness="0"
                            ToolTipService.ToolTip="模型与提供方"
                            Command="{Binding OpenProviderSettingsCommand}">
                        <Border Style="{StaticResource ReadOSChipStyle}"
                                Padding="8,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Width="6" Height="6"
                                         Fill="{ThemeResource MspAssistantAccentBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveModelLabel}"
                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Button>

                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="{Binding ThemeToggleLabel}"
                            Command="{Binding ToggleThemeCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE706;"
                                  FontSize="13" />
                    </Button>

                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="设置"
                            Command="{Binding NavigateSettingsCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE713;"
                                  FontSize="13" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 1 — Conversation hero (canonical MSP Chat UI timeline v1)
             ═══════════════════════════════════════════════════════════════ -->
        <views:ChatTimelineView x:Name="CanonicalChatSurface"
                                Grid.Row="1" />

        <!-- ── Settings overlay (replaces conversation while active) ──────── -->
        <views:SettingsView Grid.Row="1"
                            Visibility="{Binding IsSettingsRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- ── Runtime Drawer (re-homed MSP run surface; resizable + pinnable) ── -->
        <Grid Grid.Row="2"
              Height="{Binding RunDrawerHeight}"
              Visibility="{Binding IsRunDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="6" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- vertical resize grip -->
            <Border x:Name="RunDrawerResizeGrip"
                    Grid.Row="0"
                    Background="Transparent"
                    ToolTipService.ToolTip="拖动调整高度"
                    PointerPressed="RunDrawerResizeGrip_PointerPressed"
                    PointerMoved="RunDrawerResizeGrip_PointerMoved"
                    PointerReleased="RunDrawerResizeGrip_PointerReleased"
                    PointerExited="RunDrawerResizeGrip_PointerReleased" />

            <Border Grid.Row="1"
                    Background="{ThemeResource MspAppBackgroundBrush}"
                    BorderBrush="{ThemeResource MspDividerBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- header -->
                    <Grid Grid.Row="0" Padding="12,0" ColumnSpacing="8"
                          BorderBrush="{ThemeResource MspDividerBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="运行"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="固定抽屉"
                                Command="{Binding PinRunDrawerCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="{Binding RunDrawerPinGlyph}"
                                      FontSize="13" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="关闭"
                                Command="{Binding ToggleRunDrawerCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="13" />
                        </Button>
                    </Grid>

                    <!-- content: simplified MSP transcript -->
                    <ListView Grid.Row="1"
                              ItemsSource="{Binding MspTranscript}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="RunDrawerTranscript_ItemClick"
                              Padding="8">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2"
                                        CornerRadius="{StaticResource MspBubbleRadius}"
                                        Background="{ThemeResource ReadOSSubtleBrush}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding CommandText}" FontSize="12"
                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Conversation history flyout (left edge) ──────────────────── -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsHistoryFlyoutOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="#40000000" BorderThickness="0"
                    Command="{Binding CloseOverlaysCommand}" />
            <Border HorizontalAlignment="Left" Width="320"
                    Background="{ThemeResource MspAppBackgroundBrush}"
                    BorderBrush="{ThemeResource MspDividerBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="12,0" ColumnSpacing="8"
                          BorderBrush="{ThemeResource MspDividerBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="对话"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="新建线程"
                                Command="{Binding NewConversationCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="13" />
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="关闭"
                                Command="{Binding CloseOverlaysCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="13" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Padding="8">
                        <StackPanel Spacing="6">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    Padding="10,8" Background="Transparent" BorderThickness="0"
                                    Command="{Binding ImportMaterialCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8B6;" FontSize="13"
                                              Foreground="{ThemeResource MspAssistantAccentBrush}" />
                                    <TextBlock Text="导入资料"
                                               Foreground="{ThemeResource ReadOSTextSecondaryBrush}" />
                                </StackPanel>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Conversations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                Padding="10,8" Margin="0,2" Background="Transparent" BorderThickness="0"
                                                Command="{Binding DataContext.SelectConversationCommand, ElementName=RootShell}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Title}" FontSize="13"
                                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ── Pending approvals flyout (right edge) ────────────────────── -->
        <Grid Grid.RowSpan="3"
              Visibility="{Binding IsApprovalsFlyoutOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="#40000000" BorderThickness="0"
                    Command="{Binding CloseOverlaysCommand}" />
            <Border HorizontalAlignment="Right" Width="380"
                    Background="{ThemeResource MspAppBackgroundBrush}"
                    BorderBrush="{ThemeResource MspDividerBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="12,0" ColumnSpacing="8"
                          BorderBrush="{ThemeResource MspDividerBrush}" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="待审批 MSP 命令"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource ReadOSIconButtonStyle}"
                                ToolTipService.ToolTip="关闭"
                                Command="{Binding CloseOverlaysCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="13" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" Padding="12">
                        <StackPanel Spacing="10">
                            <ItemsControl ItemsSource="{Binding MspTranscript}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10" CornerRadius="{StaticResource MspBubbleRadius}"
                                                Background="{ThemeResource ReadOSSubtleBrush}"
                                                BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{Binding CommandText}" FontSize="12"
                                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11"
                                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                    <Button Height="28" Padding="10,0"
                                                            Style="{StaticResource ReadOSGhostButtonStyle}"
                                                            Command="{Binding DataContext.ApproveMspCommandCommand, ElementName=RootShell}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="通过" FontSize="11" />
                                                    </Button>
                                                    <Button Height="28" Padding="10,0"
                                                            Style="{StaticResource ReadOSGhostButtonStyle}"
                                                            Command="{Binding DataContext.DenyMspCommandCommand, ElementName=RootShell}"
                                                            CommandParameter="{Binding}">
                                                        <TextBlock Text="拒绝" FontSize="11" />
                                                    </Button>
                                                    <Button Height="28" Padding="10,0"
                                                            Style="{StaticResource ReadOSIconButtonStyle}"
                                                            ToolTipService.ToolTip="取消"
                                                            Command="{Binding DataContext.CancelMspCommandCommand, ElementName=RootShell}"
                                                            CommandParameter="{Binding}">
                                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="11" />
                                                    </Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
