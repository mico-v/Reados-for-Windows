<Application
    x:Class="ReadOS.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ReadOS.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ReadOSCanvasBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSSidebarBrush" Color="#F6F7F9" />
                    <SolidColorBrush x:Key="ReadOSSubtleBrush" Color="#F1F4F8" />
                    <SolidColorBrush x:Key="ReadOSRaisedBrush" Color="#FAFBFC" />
                    <SolidColorBrush x:Key="ReadOSBorderBrush" Color="#E3E7ED" />
                    <SolidColorBrush x:Key="ReadOSStrongBorderBrush" Color="#C9D1DA" />
                    <SolidColorBrush x:Key="ReadOSTextPrimaryBrush" Color="#111827" />
                    <SolidColorBrush x:Key="ReadOSTextSecondaryBrush" Color="#4B5563" />
                    <SolidColorBrush x:Key="ReadOSTextTertiaryBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="ReadOSBrandBrush" Color="#111827" />
                    <SolidColorBrush x:Key="ReadOSBrandTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSAccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="ReadOSAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSSuccessBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="ReadOSWarningBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="ReadOSDangerBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="ReadOSPdfPageHostBrush" Color="#D6DBE3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ReadOSCanvasBrush" Color="#171A1F" />
                    <SolidColorBrush x:Key="ReadOSSidebarBrush" Color="#111318" />
                    <SolidColorBrush x:Key="ReadOSSubtleBrush" Color="#20242B" />
                    <SolidColorBrush x:Key="ReadOSRaisedBrush" Color="#1B1F26" />
                    <SolidColorBrush x:Key="ReadOSBorderBrush" Color="#2C333D" />
                    <SolidColorBrush x:Key="ReadOSStrongBorderBrush" Color="#3E4653" />
                    <SolidColorBrush x:Key="ReadOSTextPrimaryBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="ReadOSTextSecondaryBrush" Color="#CBD5E1" />
                    <SolidColorBrush x:Key="ReadOSTextTertiaryBrush" Color="#94A3B8" />
                    <SolidColorBrush x:Key="ReadOSBrandBrush" Color="#F8FAFC" />
                    <SolidColorBrush x:Key="ReadOSBrandTextBrush" Color="#111318" />
                    <SolidColorBrush x:Key="ReadOSAccentBrush" Color="#60A5FA" />
                    <SolidColorBrush x:Key="ReadOSAccentTextBrush" Color="#0B1220" />
                    <SolidColorBrush x:Key="ReadOSSuccessBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="ReadOSWarningBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="ReadOSDangerBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="ReadOSPdfPageHostBrush" Color="#252B34" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
