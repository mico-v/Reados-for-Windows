<Window
    x:Class="ReadOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="ReadOS">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Padding="16,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="ReadOS" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="AI PDF Workspace" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <ListView Grid.Column="1"
                          ItemsSource="{Binding OpenTabs}"
                          SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                          SelectionMode="Single"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          Background="Transparent"
                          BorderThickness="0"
                          MinHeight="36">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border MinWidth="150" Padding="10,6" CornerRadius="6">
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <TextBlock Text="{Binding PageLabel}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Library" Command="{Binding ToggleLibraryPaneCommand}" />
                    <Button Content="Chat" Command="{Binding ToggleChatPaneCommand}" />
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <SplitView Grid.Row="1"
                   DisplayMode="Inline"
                   IsPaneOpen="{Binding IsLibraryPaneOpen, Mode=TwoWay}"
                   OpenPaneLength="304"
                   CompactPaneLength="0">
            <SplitView.Pane>
                <Grid Padding="16" RowSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Library" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Import" Command="{Binding ImportDocumentCommand}" />
                    </Grid>

                    <TextBox Grid.Row="1"
                             Header="Search"
                             PlaceholderText="Find folders and PDFs"
                             Text="{Binding LibrarySearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding LibraryItems}"
                              SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30"
                                            Height="30"
                                            CornerRadius="6"
                                            Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding KindLabel}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding ProgressText}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </SplitView.Pane>

            <SplitView.Content>
                <SplitView DisplayMode="Inline"
                           PanePlacement="Right"
                           IsPaneOpen="{Binding IsChatPaneOpen, Mode=TwoWay}"
                           OpenPaneLength="392"
                           CompactPaneLength="0">
                    <SplitView.Content>
                        <Grid Padding="20" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding SelectedDocumentTitle}" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedDocumentSubtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="Map Pages" Command="{Binding ConfigurePageMappingCommand}" />
                                    <Button Content="Outline" Command="{Binding GenerateOutlineCommand}" />
                                    <Button Content="Attach Page" Command="{Binding AttachCurrentPageCommand}" />
                                    <Button Content="Explain Region" Command="{Binding StartRegionExplainCommand}" />
                                </StackPanel>
                            </Grid>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding PageChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsStackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,5"
                                                Margin="0,0,8,0"
                                                CornerRadius="6"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding}" FontSize="12" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Grid.Row="2" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="272" />
                                </Grid.ColumnDefinitions>

                                <Border Padding="28"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid RowSpacing="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding ReaderHeading}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ReaderSubheading}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Row="1"
                                                Padding="28"
                                                CornerRadius="8"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                                    <TextBlock Text="{Binding CurrentPageLabel}" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding PagePreviewText}"
                                                               Width="520"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Grid.Row="2" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Previous" Command="{Binding PreviousPageCommand}" />
                                            <Slider Grid.Column="1"
                                                    Minimum="1"
                                                    Maximum="{Binding CurrentPageCount}"
                                                    Value="{Binding CurrentPageNumber, Mode=TwoWay}" />
                                            <Button Grid.Column="2" Content="Next" Command="{Binding NextPageCommand}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="14"
                                        CornerRadius="8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1">
                                    <Grid RowSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Outline" FontSize="18" FontWeight="SemiBold" />
                                        <ListView Grid.Row="1" ItemsSource="{Binding CurrentOutline}" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Padding="0,6" Spacing="2">
                                                        <TextBlock Text="{Binding Title}" TextWrapping="WrapWholeWords" />
                                                        <TextBlock Text="{Binding PageLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </SplitView.Content>

                    <SplitView.Pane>
                        <Grid Padding="16" RowSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Chat Warehouse" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding CurrentConversationScope}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="New" Command="{Binding CreateConversationCommand}" />
                            </Grid>

                            <ComboBox Grid.Row="1"
                                      Header="Conversation"
                                      ItemsSource="{Binding Conversations}"
                                      SelectedItem="{Binding CurrentConversation, Mode=TwoWay}"
                                      DisplayMemberPath="Title"
                                      HorizontalAlignment="Stretch" />

                            <ListView Grid.Row="2" ItemsSource="{Binding CurrentMessages}" SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10"
                                                Margin="0,0,0,8"
                                                CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                            <StackPanel Spacing="5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Author}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                </Grid>
                                                <TextBlock Text="{Binding Content}" TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Grid Grid.Row="3" RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ItemsControl ItemsSource="{Binding Attachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="8"
                                                    Margin="0,0,0,6"
                                                    CornerRadius="6"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Grid.Row="1"
                                         PlaceholderText="Ask about this PDF..."
                                         Text="{Binding PromptDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         MinHeight="72" />
                            </Grid>
                        </Grid>
                    </SplitView.Pane>
                </SplitView>
            </SplitView.Content>
        </SplitView>

        <Border Grid.Row="2"
                Padding="14,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding ActiveModelLabel}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
