<Application
    x:Class="ReadOS.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ReadOS.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ═══════════════════════════════════════════════════════════
                 Theme dictionaries — recolored to the MSP WEBUI Default
                 renderer manifest (renderer.manifest.json "style" tokens).
                 Light = manifest.style, Dark = manifest.style.themeOverrides.dark.
                 ═══════════════════════════════════════════════════════════ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- MSP surface tokens -->
                    <SolidColorBrush x:Key="MspAppBackgroundBrush" Color="#f4f1ea" />
                    <SolidColorBrush x:Key="MspUserBubbleBackgroundBrush" Color="#000000" Opacity="0.055" />
                    <SolidColorBrush x:Key="MspUserBubbleBorderBrush" Color="#172233" Opacity="0.08" />
                    <SolidColorBrush x:Key="MspAssistantAccentBrush" Color="#1b67a8" />
                    <SolidColorBrush x:Key="MspUserAccentBrush" Color="#666666" />
                    <SolidColorBrush x:Key="MspChipBackgroundBrush" Color="#142132" Opacity="0.06" />
                    <SolidColorBrush x:Key="MspCodeBackgroundBrush" Color="#122031" Opacity="0.07" />
                    <SolidColorBrush x:Key="MspCodeBackgroundSoftBrush" Color="#122031" Opacity="0.06" />
                    <SolidColorBrush x:Key="MspBlockquoteBorderBrush" Color="#125491" Opacity="0.24" />
                    <SolidColorBrush x:Key="MspDividerBrush" Color="#141c26" Opacity="0.16" />

                    <!-- ReadOS role brushes mapped onto the MSP light palette -->
                    <SolidColorBrush x:Key="ReadOSCanvasBrush" Color="#f4f1ea" />
                    <SolidColorBrush x:Key="ReadOSChromeBrush" Color="#f8f8f9" />
                    <SolidColorBrush x:Key="ReadOSSidebarBrush" Color="#f8f8f9" />
                    <SolidColorBrush x:Key="ReadOSPanelBrush" Color="#f8f8f9" />
                    <SolidColorBrush x:Key="ReadOSSubtleBrush" Color="#122031" Opacity="0.06" />
                    <SolidColorBrush x:Key="ReadOSRaisedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSElevatedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSBorderBrush" Color="#172233" Opacity="0.08" />
                    <SolidColorBrush x:Key="ReadOSStrongBorderBrush" Color="#141c26" Opacity="0.16" />
                    <SolidColorBrush x:Key="ReadOSHairlineBrush" Color="#172233" Opacity="0.06" />
                    <SolidColorBrush x:Key="ReadOSListHoverBrush" Color="#142132" Opacity="0.06" />
                    <SolidColorBrush x:Key="ReadOSListSelectedBrush" Color="#1b67a8" Opacity="0.10" />
                    <SolidColorBrush x:Key="ReadOSButtonBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSButtonHoverBrush" Color="#142132" Opacity="0.06" />
                    <SolidColorBrush x:Key="ReadOSButtonPressedBrush" Color="#142132" Opacity="0.12" />
                    <SolidColorBrush x:Key="ReadOSButtonBorderBrush" Color="#172233" Opacity="0.12" />
                    <SolidColorBrush x:Key="ReadOSTextPrimaryBrush" Color="#172233" />
                    <SolidColorBrush x:Key="ReadOSTextSecondaryBrush" Color="#172233" Opacity="0.68" />
                    <SolidColorBrush x:Key="ReadOSTextTertiaryBrush" Color="#172233" Opacity="0.45" />
                    <SolidColorBrush x:Key="ReadOSBrandBrush" Color="#172233" />
                    <SolidColorBrush x:Key="ReadOSBrandTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSAccentBrush" Color="#1b67a8" />
                    <SolidColorBrush x:Key="ReadOSAccentTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSAccentMutedBrush" Color="#1b67a8" Opacity="0.10" />
                    <SolidColorBrush x:Key="ReadOSPrimaryButtonHoverBrush" Color="#15599a" />
                    <SolidColorBrush x:Key="ReadOSPrimaryButtonPressedBrush" Color="#114c84" />
                    <SolidColorBrush x:Key="ReadOSSuccessBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="ReadOSWarningBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="ReadOSDangerBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="ReadOSPdfPageHostBrush" Color="#e2e6ea" />
                    <SolidColorBrush x:Key="ReadOSSplitterHoverBrush" Color="#172233" Opacity="0.30" />

                    <SolidColorBrush x:Key="ButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#142132" Opacity="0.06" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#142132" Opacity="0.12" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#172233" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#172233" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#172233" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#172233" Opacity="0.12" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#141c26" Opacity="0.16" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#141c26" Opacity="0.20" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#142132" Opacity="0.06" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#142132" Opacity="0.12" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#172233" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#2c3645" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#111318" />
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#172233" Opacity="0.68" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#172233" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#172233" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#172233" Opacity="0.12" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#141c26" Opacity="0.16" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#172233" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <!-- MSP surface tokens -->
                    <SolidColorBrush x:Key="MspAppBackgroundBrush" Color="#0f141b" />
                    <SolidColorBrush x:Key="MspUserBubbleBackgroundBrush" Color="#FFFFFF" Opacity="0.10" />
                    <SolidColorBrush x:Key="MspUserBubbleBorderBrush" Color="#FFFFFF" Opacity="0.14" />
                    <SolidColorBrush x:Key="MspAssistantAccentBrush" Color="#8abdf2" />
                    <SolidColorBrush x:Key="MspUserAccentBrush" Color="#b8c0cc" />
                    <SolidColorBrush x:Key="MspChipBackgroundBrush" Color="#FFFFFF" Opacity="0.08" />
                    <SolidColorBrush x:Key="MspCodeBackgroundBrush" Color="#FFFFFF" Opacity="0.08" />
                    <SolidColorBrush x:Key="MspCodeBackgroundSoftBrush" Color="#FFFFFF" Opacity="0.07" />
                    <SolidColorBrush x:Key="MspBlockquoteBorderBrush" Color="#8abdf2" Opacity="0.30" />
                    <SolidColorBrush x:Key="MspDividerBrush" Color="#FFFFFF" Opacity="0.16" />

                    <!-- ReadOS role brushes mapped onto the MSP dark palette -->
                    <SolidColorBrush x:Key="ReadOSCanvasBrush" Color="#0f141b" />
                    <SolidColorBrush x:Key="ReadOSChromeBrush" Color="#141a22" />
                    <SolidColorBrush x:Key="ReadOSSidebarBrush" Color="#141a22" />
                    <SolidColorBrush x:Key="ReadOSPanelBrush" Color="#141a22" />
                    <SolidColorBrush x:Key="ReadOSSubtleBrush" Color="#FFFFFF" Opacity="0.07" />
                    <SolidColorBrush x:Key="ReadOSRaisedBrush" Color="#1b2129" />
                    <SolidColorBrush x:Key="ReadOSElevatedBrush" Color="#1b2129" />
                    <SolidColorBrush x:Key="ReadOSBorderBrush" Color="#FFFFFF" Opacity="0.12" />
                    <SolidColorBrush x:Key="ReadOSStrongBorderBrush" Color="#FFFFFF" Opacity="0.16" />
                    <SolidColorBrush x:Key="ReadOSHairlineBrush" Color="#FFFFFF" Opacity="0.08" />
                    <SolidColorBrush x:Key="ReadOSListHoverBrush" Color="#FFFFFF" Opacity="0.08" />
                    <SolidColorBrush x:Key="ReadOSListSelectedBrush" Color="#8abdf2" Opacity="0.14" />
                    <SolidColorBrush x:Key="ReadOSButtonBrush" Color="#1b2129" />
                    <SolidColorBrush x:Key="ReadOSButtonHoverBrush" Color="#FFFFFF" Opacity="0.08" />
                    <SolidColorBrush x:Key="ReadOSButtonPressedBrush" Color="#FFFFFF" Opacity="0.14" />
                    <SolidColorBrush x:Key="ReadOSButtonBorderBrush" Color="#FFFFFF" Opacity="0.16" />
                    <SolidColorBrush x:Key="ReadOSTextPrimaryBrush" Color="#e6edf5" />
                    <SolidColorBrush x:Key="ReadOSTextSecondaryBrush" Color="#e6edf5" Opacity="0.68" />
                    <SolidColorBrush x:Key="ReadOSTextTertiaryBrush" Color="#e6edf5" Opacity="0.45" />
                    <SolidColorBrush x:Key="ReadOSBrandBrush" Color="#e6edf5" />
                    <SolidColorBrush x:Key="ReadOSBrandTextBrush" Color="#0f141b" />
                    <SolidColorBrush x:Key="ReadOSAccentBrush" Color="#8abdf2" />
                    <SolidColorBrush x:Key="ReadOSAccentTextBrush" Color="#0D0D0D" />
                    <SolidColorBrush x:Key="ReadOSAccentMutedBrush" Color="#8abdf2" Opacity="0.14" />
                    <SolidColorBrush x:Key="ReadOSPrimaryButtonHoverBrush" Color="#a6cdf5" />
                    <SolidColorBrush x:Key="ReadOSPrimaryButtonPressedBrush" Color="#6fa8e0" />
                    <SolidColorBrush x:Key="ReadOSSuccessBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="ReadOSWarningBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="ReadOSDangerBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="ReadOSPdfPageHostBrush" Color="#252b34" />
                    <SolidColorBrush x:Key="ReadOSSplitterHoverBrush" Color="#FFFFFF" Opacity="0.30" />

                    <SolidColorBrush x:Key="ButtonBackground" Color="#1b2129" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#FFFFFF" Opacity="0.08" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#FFFFFF" Opacity="0.14" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#e6edf5" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFFFFF" Opacity="0.16" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FFFFFF" Opacity="0.28" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#FFFFFF" Opacity="0.34" />
                    <SolidColorBrush x:Key="ToggleButtonBackground" Color="#1b2129" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#FFFFFF" Opacity="0.08" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#FFFFFF" Opacity="0.14" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#e6edf5" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#dadde3" />
                    <SolidColorBrush x:Key="ToggleButtonForeground" Color="#e6edf5" Opacity="0.68" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#0f141b" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#0f141b" />
                    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#0f141b" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#FFFFFF" Opacity="0.16" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#FFFFFF" Opacity="0.28" />
                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#e6edf5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ═══════════════════════════════════════════════════════════
                 Spacing / sizing tokens (theme-independent)
                 ═══════════════════════════════════════════════════════════ -->
            <x:Double x:Key="SpacingXxs">4</x:Double>
            <x:Double x:Key="SpacingXs">6</x:Double>
            <x:Double x:Key="SpacingSm">8</x:Double>
            <x:Double x:Key="SpacingMd">12</x:Double>
            <x:Double x:Key="SpacingLg">16</x:Double>
            <x:Double x:Key="SpacingXl">20</x:Double>
            <x:Double x:Key="SpacingXxl">24</x:Double>

            <x:Double x:Key="ControlHeightSm">28</x:Double>
            <x:Double x:Key="ControlHeightMd">34</x:Double>
            <x:Double x:Key="ControlHeightLg">40</x:Double>

            <x:Double x:Key="IconSizeSm">12</x:Double>
            <x:Double x:Key="IconSizeMd">14</x:Double>
            <x:Double x:Key="IconSizeLg">16</x:Double>

            <CornerRadius x:Key="RadiusSm">4</CornerRadius>
            <CornerRadius x:Key="RadiusMd">6</CornerRadius>
            <CornerRadius x:Key="RadiusLg">8</CornerRadius>
            <CornerRadius x:Key="RadiusXl">10</CornerRadius>
            <CornerRadius x:Key="RadiusPill">999</CornerRadius>

            <x:Double x:Key="FontSizeXs">11</x:Double>
            <x:Double x:Key="FontSizeSm">12</x:Double>
            <x:Double x:Key="FontSizeMd">14</x:Double>
            <x:Double x:Key="FontSizeLg">15.5</x:Double>
            <x:Double x:Key="FontSizeXl">18</x:Double>

            <!-- ═══════════════════════════════════════════════════════════
                 MSP WEBUI Default renderer tokens (renderer.manifest.json)
                 Theme-independent geometry / typography.
                 ═══════════════════════════════════════════════════════════ -->
            <CornerRadius x:Key="MspBubbleRadius">22</CornerRadius>
            <Thickness x:Key="MspBubblePadding">16,12</Thickness>
            <x:Double x:Key="MspMessageGap">12</x:Double>
            <x:Double x:Key="MspPagePaddingX">12</x:Double>
            <x:Double x:Key="MspPagePaddingY">18</x:Double>
            <x:Double x:Key="MspPagePaddingTop">56.5</x:Double>
            <x:Double x:Key="MspPagePaddingBottom">18</x:Double>
            <x:Double x:Key="MspBodyFontSize">15.5</x:Double>
            <x:Double x:Key="MspRoleFontSize">12</x:Double>
            <x:Double x:Key="MspMetaFontSize">11</x:Double>
            <x:Double x:Key="MspSupportFontSize">14</x:Double>
            <x:Double x:Key="MspContentMaxWidth">640</x:Double>
            <x:Double x:Key="MspBubbleMaxWidth">720</x:Double>
            <x:Double x:Key="MspUserBubbleCornerRadius">22</x:Double>
            <x:Double x:Key="MspAssistantBubbleCornerRadius">22</x:Double>
            <x:Double x:Key="MspGeneratedImageCornerRadius">22</x:Double>

            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
            <converters:NullableDoubleConverter x:Key="NullableDouble" />

            <!-- Codex-inspired shell styles: quiet surfaces, hairline borders, compact actions. -->
            <Style x:Key="ReadOSBaseButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                <Setter Property="Background" Value="{ThemeResource ReadOSButtonBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ReadOSTextPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ReadOSButtonHoverBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource ReadOSStrongBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ReadOSButtonPressedBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource ReadOSStrongBorderBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource ReadOSBaseButtonStyle}" />

            <Style x:Key="ReadOSPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ReadOSBaseButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource ReadOSAccentBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ReadOSAccentTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSAccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ReadOSPrimaryButtonHoverBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource ReadOSPrimaryButtonHoverBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource ReadOSPrimaryButtonPressedBrush}" />
                                                <Setter Target="Root.BorderBrush" Value="{ThemeResource ReadOSPrimaryButtonPressedBrush}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.45" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ReadOSGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource ReadOSBaseButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource ReadOSTextSecondaryBrush}" />
            </Style>

            <Style x:Key="ReadOSIconButtonStyle" TargetType="Button" BasedOn="{StaticResource ReadOSGhostButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ReadOSBaseToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="MinHeight" Value="{StaticResource ControlHeightSm}" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                <Setter Property="Background" Value="{ThemeResource ReadOSButtonBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource ReadOSTextSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="{StaticResource FontSizeSm}" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style TargetType="ToggleButton" BasedOn="{StaticResource ReadOSBaseToggleButtonStyle}" />

            <Style x:Key="ReadOSSegmentButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ReadOSBaseToggleButtonStyle}">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="8,0" />
            </Style>

            <Style x:Key="ReadOSRailButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ReadOSBaseToggleButtonStyle}">
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ReadOSLeftPaneStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ReadOSPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,0" />
            </Style>

            <Style x:Key="ReadOSRightPaneStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ReadOSPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSBorderBrush}" />
                <Setter Property="BorderThickness" Value="1,0,0,0" />
            </Style>

            <Style x:Key="ReadOSTopBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ReadOSChromeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <Style x:Key="ReadOSPaneToolbarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ReadOSChromeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <Style x:Key="ReadOSCardStyle" TargetType="Border">
                <Setter Property="Padding" Value="12" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
                <Setter Property="Background" Value="{ThemeResource ReadOSRaisedBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="ReadOSSubtleCardStyle" TargetType="Border" BasedOn="{StaticResource ReadOSCardStyle}">
                <Setter Property="Padding" Value="9" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                <Setter Property="Background" Value="{ThemeResource ReadOSSubtleBrush}" />
            </Style>

            <Style x:Key="ReadOSComposerPanelStyle" TargetType="Border" BasedOn="{StaticResource ReadOSCardStyle}">
                <Setter Property="Padding" Value="10" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
                <Setter Property="Background" Value="{ThemeResource ReadOSElevatedBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSStrongBorderBrush}" />
            </Style>

            <Style x:Key="ReadOSChipStyle" TargetType="Border">
                <Setter Property="Padding" Value="7,4" />
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
                <Setter Property="Background" Value="{ThemeResource MspChipBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <Style x:Key="ReadOSBottomDrawerStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ReadOSPanelBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>

            <Style x:Key="ReadOSStatusBarStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ReadOSChromeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ReadOSBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
