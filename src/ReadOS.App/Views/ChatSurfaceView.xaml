<UserControl
    x:Class="ReadOS.App.Views.ChatSurfaceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Border Background="{ThemeResource ReadOSCanvasBrush}"
            BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="Agent 对话" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding PendingAttachmentSummary}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="显示侧栏" Click="RestoreSidebarButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE700;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="显示检查器" Click="RestoreInspectorButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A0;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="平铺双视窗" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="ChatPrimary">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A9;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="打开演示视窗" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="PresenterPrimary">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" ToolTipService.ToolTip="对话全屏" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="FocusChat">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorSplitterColumn" Width="1" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="316" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="168" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Padding="20,18">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="14" CornerRadius="8" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Author}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Attachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" Padding="8" CornerRadius="7" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Spacing="1">
                                                                    <TextBlock Text="{Binding Title}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Content}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextWrapping="WrapWholeWords" LineHeight="20" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1" Margin="16,0,16,16" Padding="12" CornerRadius="18" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSStrongBorderBrush}" BorderThickness="1">
                        <Grid RowSpacing="9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding PendingAttachmentSummary}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="清空附件" Command="{Binding ClearAttachmentsCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>
                            <TextBox Grid.Row="1"
                                     MinHeight="72"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     TextWrapping="Wrap"
                                     PlaceholderText="向阅读 Agent 发起任务..."
                                     Text="{Binding ComposerDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBox Width="124" Height="34" PlaceholderText="1-3, 8" Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Height="34" Padding="10,0" Background="Transparent" BorderThickness="0" Command="{Binding AttachRangeCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="12" />
                                            <TextBlock Text="附加范围" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" MinWidth="88" Padding="14,0" Command="{Binding SendPromptCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="发送" FontWeight="SemiBold" />
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Background="Transparent">
                    <Rectangle Width="1" Fill="{ThemeResource ReadOSBorderBrush}" HorizontalAlignment="Center" />
                    <primitives:Thumb Width="12" HorizontalAlignment="Center" Background="Transparent" DragDelta="InspectorResizeThumb_DragDelta" />
                </Grid>

                <Border Grid.Column="2" Background="{ThemeResource ReadOSSidebarBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1,0,0,0">
                    <Grid Padding="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="Agent Inspector" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveModelLabel}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="隐藏检查器" Command="{Binding ToggleChatCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BB;" FontSize="12" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ToggleButton Height="32" MinWidth="62" IsChecked="{Binding IsContextInspectorSelected, Mode=OneWay}" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Context" Content="上下文" />
                                <ToggleButton Height="32" MinWidth="62" IsChecked="{Binding IsActionsInspectorSelected, Mode=OneWay}" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Actions" Content="动作" />
                                <ToggleButton Height="32" MinWidth="62" IsChecked="{Binding IsEvidenceInspectorSelected, Mode=OneWay}" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Evidence" Content="证据" />
                                <ToggleButton Height="32" MinWidth="62" IsChecked="{Binding IsAttachmentsInspectorSelected, Mode=OneWay}" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Attachments" Content="附件" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2">
                            <ScrollViewer Visibility="{Binding IsContextInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="当前文档" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ActiveTitle}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{Binding ActiveSubtitle}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="4" />
                                            <TextBox Header="文件名" Text="{Binding DocumentNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Height="34" Command="{Binding RenameDocumentCommand}" Content="重命名" />
                                                <Button Grid.Column="1" Height="34" Command="{Binding DeleteDocumentCommand}" Content="删除" />
                                            </Grid>
                                            <Button Height="34" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding OpenLocationCommand}" Content="打开位置" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="工作区" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding ExportWorkspaceCommand}" Content="导出工作区" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding ImportWorkspaceCommand}" Content="导入工作区" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Visibility="{Binding IsActionsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="对话操作" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding NewConversationCommand}" Content="新建对话" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding ClearConversationCommand}" Content="清空当前对话" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="布局" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Button Height="34" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="ChatPrimary" Content="平铺：对话优先" />
                                            <Button Height="34" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="PresenterPrimary" Content="平铺：演示优先" />
                                            <Button Height="34" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="FocusChat" Content="对话全屏" />
                                            <Button Height="34" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="FocusPresenter" Content="演示全屏" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Visibility="{Binding IsEvidenceInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="状态" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{Binding PendingAttachmentSummary}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="模型" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ActiveModelLabel}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding NavigateSettingsCommand}" Content="模型设置" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Visibility="{Binding IsAttachmentsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="附加材料" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Height="34" Command="{Binding AttachCurrentPageCommand}" Content="本页/全文" />
                                                <Button Grid.Column="1" Height="34" Command="{Binding StartRegionSelectionCommand}" Content="框选" />
                                            </Grid>
                                            <TextBox Height="34" PlaceholderText="1-3, 8" Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Height="34" Command="{Binding AttachRangeCommand}" Content="附加范围" />
                                                <Button Grid.Column="1" Height="34" Command="{Binding ClearAttachmentsCommand}" Content="清空" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Title}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
