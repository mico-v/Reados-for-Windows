<Window
    x:Class="ReadOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Title="ReadOS">

    <Grid x:Name="RootShell" Background="{ThemeResource ReadOSCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="10,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource ReadOSBrandBrush}">
                        <TextBlock Text="R" Foreground="{ThemeResource ReadOSBrandTextBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0">
                        <TextBlock Text="ReadOS" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ActiveModelLabel}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button MinWidth="78" Height="34" Padding="12,0" Background="Transparent" BorderThickness="0" Command="{Binding NavigateHomeCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE80F;" FontSize="14" />
                            <TextBlock Text="对话" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="78" Height="34" Padding="12,0" Background="Transparent" BorderThickness="0" Command="{Binding NavigateReaderCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="14" />
                            <TextBlock Text="阅读" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="78" Height="34" Padding="12,0" Background="Transparent" BorderThickness="0" Command="{Binding NavigateSettingsCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                            <TextBlock Text="设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="切换左栏" Command="{Binding ToggleLibraryCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE700;" FontSize="15" />
                    </Button>
                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="切换右栏" Command="{Binding ToggleChatCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A0;" FontSize="15" />
                    </Button>
                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="导入资料" Command="{Binding ImportMaterialCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" FontSize="15" />
                    </Button>
                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="新对话" Command="{Binding NewConversationCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="15" />
                    </Button>
                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE706;" FontSize="15" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsHomeRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="1" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ChatSplitterColumn" Width="1" />
                <ColumnDefinition x:Name="ChatColumn" Width="324" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource ReadOSSidebarBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="14" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="任务" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="新对话" Command="{Binding NewConversationCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="15" />
                        </Button>
                        <Button Grid.Column="2" Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="清空当前对话" Command="{Binding ClearConversationCommand}">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="15" />
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1" Height="36" PlaceholderText="搜索项目和文件" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <ListView Grid.Row="2"
                              ItemsSource="{Binding Conversations}"
                              SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                              Background="Transparent"
                              BorderThickness="0"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,9" ColumnSpacing="10" MinHeight="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="8" Background="{ThemeResource ReadOSBorderBrush}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BD;" FontSize="14" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding UpdatedAt}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Grid.Row="3" Spacing="8">
                        <Button Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding NavigateReaderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="14" />
                                <TextBlock Text="打开阅读页" />
                            </StackPanel>
                        </Button>
                        <Button Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding ImportMaterialCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" FontSize="14" />
                                <TextBlock Text="导入资料" />
                            </StackPanel>
                        </Button>
                        <Button Height="36" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding CreateProjectCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8F4;" FontSize="14" />
                                <TextBlock Text="新建项目" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource ReadOSBorderBrush}">
                <primitives:Thumb Width="8" HorizontalAlignment="Center" Background="Transparent" DragDelta="SidebarResizeThumb_DragDelta" />
            </Border>

            <Grid Grid.Column="2" Background="{ThemeResource ReadOSCanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="86" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="164" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="{Binding ActiveTitle}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ActiveSubtitle}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Height="34" Padding="12,0" Command="{Binding AttachCurrentPageCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="本页" />
                                </StackPanel>
                            </Button>
                            <Button Height="34" Padding="12,0" Command="{Binding StartRegionSelectionCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEF20;" FontSize="14" />
                                    <TextBlock Text="框选" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" Padding="22,20">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" CornerRadius="10" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                    <StackPanel Spacing="9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Author}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding Timestamp}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Attachments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6" Padding="8" CornerRadius="8" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="1">
                                                                <TextBlock Text="{Binding Title}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Content}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextWrapping="WrapWholeWords" LineHeight="20" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Margin="22,0,22,18" Padding="12" CornerRadius="24" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSStrongBorderBrush}" BorderThickness="1">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PendingAttachmentSummary}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Height="28" Padding="8,0" Background="Transparent" BorderThickness="0" Command="{Binding ClearAttachmentsCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                            </Button>
                        </Grid>
                        <TextBox Grid.Row="1"
                                 MinHeight="74"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 PlaceholderText="输入任务..."
                                 Text="{Binding ComposerDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Grid.Row="2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox Width="126" Height="34" PlaceholderText="1-3, 8" Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Height="34" Padding="10,0" Background="Transparent" BorderThickness="0" Command="{Binding AttachRangeCommand}">
                                    <TextBlock Text="附加范围" />
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="1" Height="36" MinWidth="88" Padding="14,0" Command="{Binding SendPromptCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="发送" FontWeight="SemiBold" />
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="3" Background="{ThemeResource ReadOSBorderBrush}">
                <primitives:Thumb Width="8" HorizontalAlignment="Center" Background="Transparent" DragDelta="ChatResizeThumb_DragDelta" />
            </Border>

            <Border Grid.Column="4" Background="{ThemeResource ReadOSSidebarBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer>
                    <StackPanel Padding="14" Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="上下文" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding CurrentPageIndicator}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                        </StackPanel>

                        <Border Padding="12" CornerRadius="10" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="8">
                                <TextBlock Text="当前文档" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveTitle}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextWrapping="WrapWholeWords" />
                                <TextBlock Text="{Binding ActiveSubtitle}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="3" />
                                <TextBox Height="34" PlaceholderText="文件名" Text="{Binding DocumentNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Height="34" Command="{Binding RenameDocumentCommand}">
                                        <TextBlock Text="重命名" />
                                    </Button>
                                    <Button Grid.Column="1" Height="34" Command="{Binding DeleteDocumentCommand}">
                                        <TextBlock Text="删除" />
                                    </Button>
                                </Grid>
                                <Button Height="34" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding OpenLocationCommand}">
                                    <TextBlock Text="打开位置" />
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" CornerRadius="10" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="资料库" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                <TextBox Height="34" PlaceholderText="搜索资料" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Height="34" Command="{Binding CreateProjectCommand}">
                                        <TextBlock Text="新建项目" />
                                    </Button>
                                    <Button Grid.Column="1" Height="34" Command="{Binding ImportMaterialCommand}">
                                        <TextBlock Text="导入资料" />
                                    </Button>
                                </Grid>
                                <ListView MaxHeight="178"
                                          ItemsSource="{Binding LibraryItems}"
                                          SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="6,7" ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="32" CornerRadius="6" Background="{ThemeResource ReadOSBorderBrush}">
                                                    <TextBlock Text="{Binding KindLabel}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1">
                                                    <TextBlock Text="{Binding Name}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Border Padding="12" CornerRadius="10" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="附件" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Width="30" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Command="{Binding ClearAttachmentsCommand}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                                    </Button>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,6" Padding="8" CornerRadius="8" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Title}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Background="{ThemeResource ReadOSCanvasBrush}" Visibility="{Binding IsReaderRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ReaderThumbnailColumn" Width="164" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ReaderOutlineColumn" Width="270" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource ReadOSSidebarBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="缩略图" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1">
                        <ListView ItemsSource="{Binding Thumbnails}"
                                  SelectedItem="{Binding SelectedThumbnail, Mode=TwoWay}"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="5" Margin="0,0,0,10">
                                        <Border Background="{ThemeResource ReadOSCanvasBrush}" Padding="3" BorderBrush="{ThemeResource ReadOSStrongBorderBrush}" BorderThickness="1">
                                            <Image Source="{Binding Image}" Width="112" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{Binding Label}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button Width="34" Height="34" Padding="0" Command="{Binding PreviousPageCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="13" />
                                </Button>
                                <Button Width="34" Height="34" Padding="0" Command="{Binding NextPageCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72A;" FontSize="13" />
                                </Button>
                                <TextBox Width="78" Height="34" PlaceholderText="页码" Text="{Binding PageJumpText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Height="34" Padding="10,0" Content="跳转" Command="{Binding JumpToPageCommand}" />
                                <Button Height="34" Padding="10,0" Content="缩略图" Command="{Binding ToggleThumbnailsCommand}" />
                                <Button Height="34" Padding="10,0" Content="目录" Command="{Binding ToggleOutlineCommand}" />
                                <Button Height="34" Padding="10,0" Content="附加本页" Command="{Binding AttachCurrentPageCommand}" />
                                <TextBox Width="120" Height="34" PlaceholderText="1-3, 8" Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Height="34" Padding="10,0" Content="附加范围" Command="{Binding AttachRangeCommand}" />
                                <Button Height="34" Padding="10,0" Content="框选讲解" Command="{Binding StartRegionSelectionCommand}" />
                            </StackPanel>
                        </ScrollViewer>
                        <Slider Grid.Column="1" Minimum="420" Maximum="1280" Value="{Binding ReaderImageWidth, Mode=TwoWay}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding CurrentPageIndicator}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid Padding="24" HorizontalAlignment="Center">
                        <Border Visibility="{Binding HasPageImage, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                                Width="520"
                                MinHeight="360"
                                Padding="28"
                                Background="{ThemeResource ReadOSCanvasBrush}"
                                BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="未打开 PDF" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <Button Content="导入 PDF" HorizontalAlignment="Center" Padding="14,8" Command="{Binding ImportMaterialCommand}" />
                            </StackPanel>
                        </Border>

                        <Grid Visibility="{Binding HasPageImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Border Background="{ThemeResource ReadOSPdfPageHostBrush}" Padding="10" CornerRadius="3">
                                <Image x:Name="PdfPageImage"
                                       Source="{Binding CurrentPageImage}"
                                       Width="{Binding ReaderImageWidth}"
                                       Stretch="Uniform" />
                            </Border>
                            <Canvas x:Name="RegionCanvas"
                                    Background="Transparent"
                                    Visibility="{Binding IsRegionModeActive, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    PointerPressed="RegionCanvas_PointerPressed"
                                    PointerMoved="RegionCanvas_PointerMoved"
                                    PointerReleased="RegionCanvas_PointerReleased">
                                <Rectangle x:Name="RegionRectangle"
                                           Visibility="Collapsed"
                                           Stroke="#FF3B30"
                                           StrokeThickness="3"
                                           Fill="#33FF3B30" />
                            </Canvas>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <Border Grid.Column="2" Background="{ThemeResource ReadOSSidebarBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1,0,0,0">
                <Grid Padding="12" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="页码与目录" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" />
                    <Grid Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Header="当前页标签" Text="{Binding CurrentPageLabelDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="保存" Padding="10,6" VerticalAlignment="Bottom" Command="{Binding SavePageLabelCommand}" />
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="自动映射" Padding="10,6" Command="{Binding AutoMapPagesCommand}" />
                        <Button Content="生成目录" Padding="10,6" Command="{Binding GenerateOutlineCommand}" />
                    </StackPanel>
                    <ListView Grid.Row="3" ItemsSource="{Binding Outline}" SelectedItem="{Binding SelectedOutlineItem, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding IndentedTitle}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Page}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid Grid.Row="4" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="目录标题" Text="{Binding OutlineTitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="添加" Padding="8,6" Command="{Binding AddOutlineItemCommand}" />
                        <Button Grid.Column="2" Content="删除" Padding="8,6" Command="{Binding DeleteOutlineItemCommand}" />
                    </Grid>
                    <Grid Grid.Row="5" RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox PlaceholderText="全文搜索" Text="{Binding DocumentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="搜索" Padding="8,6" Command="{Binding SearchInDocumentCommand}" />
                        </Grid>
                        <ListView Grid.Row="1" ItemsSource="{Binding DocumentSearchResults}" SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,4">
                                        <TextBlock Text="{Binding PageNumber}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" FontSize="12" />
                                        <TextBlock Text="{Binding Preview}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" MaxLines="3" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Background="{ThemeResource ReadOSCanvasBrush}" Visibility="{Binding IsSettingsRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource ReadOSSidebarBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,1,0">
                <Grid Padding="16" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="设置" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ActiveModelLabel}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="8">
                        <Button Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="General">
                            <TextBlock Text="通用" />
                        </Button>
                        <Button Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Provider">
                            <TextBlock Text="模型服务" />
                        </Button>
                        <Button Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Prompts">
                            <TextBlock Text="提示词" />
                        </Button>
                        <Button Height="38" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Command="{Binding SelectSettingsCategoryCommand}" CommandParameter="Workspace">
                            <TextBlock Text="工作区" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource ReadOSCanvasBrush}">
                <Grid Padding="28" RowSpacing="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="偏好设置" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1" Height="36" Padding="12,0" Command="{Binding NavigateHomeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE72B;" FontSize="13" />
                                <TextBlock Text="返回" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1">
                        <Grid MaxWidth="720" HorizontalAlignment="Left">
                            <StackPanel Spacing="18" Visibility="{Binding IsGeneralSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ComboBox Header="语言"
                                          Width="360"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <ToggleSwitch Header="深色模式" IsOn="{Binding IsDarkTheme, Mode=TwoWay}" />
                                <ToggleSwitch Header="使用离线阅读回答" IsOn="{Binding UseOfflineResponses, Mode=TwoWay}" />
                                <TextBox Header="MinorU 地址" Width="520" Text="{Binding MinorUEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Spacing="18" Visibility="{Binding IsProviderSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Header="服务商名称" Width="420" Text="{Binding ProviderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="Base URL" Width="560" Text="{Binding ProviderBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="API Key" Width="560" Text="{Binding ProviderApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="模型名称" Width="420" Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <StackPanel Spacing="18" Visibility="{Binding IsPromptSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBox Header="附件默认提示词" Width="640" Text="{Binding AttachmentDefaultPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap" />
                                <TextBox Header="框选讲解提示词" Width="640" Text="{Binding RegionExplainPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap" />
                                <TextBox Header="章节讲解提示词" Width="640" Text="{Binding ChapterExplainPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="82" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="18" Visibility="{Binding IsWorkspaceSettingsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Width="640" Padding="14" CornerRadius="10" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="当前工作区" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ActiveSubtitle}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Height="36" Padding="12,0" Content="导出工作区" Command="{Binding ExportWorkspaceCommand}" />
                                    <Button Height="36" Padding="12,0" Content="导入工作区" Command="{Binding ImportWorkspaceCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Height="36" Padding="14,0" Content="保存设置" Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                <ProgressRing Grid.Column="1" Width="18" Height="18" IsActive="{Binding IsBusy}" />
            </Grid>
        </Border>
    </Grid>
</Window>
