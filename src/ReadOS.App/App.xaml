                    <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#E5E7EB" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#1F2328" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#30343A" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#111318" />
