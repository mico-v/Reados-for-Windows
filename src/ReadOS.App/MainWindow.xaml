<Window
    x:Class="ReadOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:ReadOS.App.Views"
    mc:Ignorable="d"
    Title="ReadOS">

    <Grid x:Name="RootShell" Background="{ThemeResource ReadOSCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 0 — Title bar / toolbar (48 px)
             Left: brand + function buttons.  Right: reserved for native caption buttons.
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{ThemeResource ReadOSCanvasBrush}"
                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ══ Left: brand + compact function buttons ══ -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Border Width="26" Height="26"
                            CornerRadius="6"
                            Background="{ThemeResource ReadOSBrandBrush}">
                        <TextBlock Text="R"
                                   Foreground="{ThemeResource ReadOSBrandTextBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Visual separator -->
                    <Border Width="1" Height="18"
                            Background="{ThemeResource ReadOSBorderBrush}"
                            Margin="6,0,4,0" />

                    <!-- Import -->
                    <Button Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="6"
                            ToolTipService.ToolTip="导入资料"
                            Command="{Binding ImportMaterialCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE8E5;"
                                  FontSize="13" />
                    </Button>

                    <!-- New thread -->
                    <Button Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="6"
                            ToolTipService.ToolTip="新建线程"
                            Command="{Binding NewConversationCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE710;"
                                  FontSize="13" />
                    </Button>

                    <!-- Theme toggle -->
                    <Button Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="6"
                            ToolTipService.ToolTip="{Binding ThemeToggleLabel}"
                            Command="{Binding ToggleThemeCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE706;"
                                  FontSize="13" />
                    </Button>

                    <!-- Settings -->
                    <Button Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            CornerRadius="6"
                            ToolTipService.ToolTip="设置"
                            Command="{Binding NavigateSettingsCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE713;"
                                  FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- ══ Drag region (system double-click / right-click) ══ -->
                <Grid Grid.Column="1"
                      x:Name="TitleBarDragRegion"
                      Background="Transparent">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0">
                        <Border Padding="5,3"
                                CornerRadius="6"
                                Background="{ThemeResource ReadOSSubtleBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="5">
                                <Ellipse Width="5" Height="5"
                                         Fill="{ThemeResource ReadOSSuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveModelLabel}"
                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ActiveTitle}"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 1 — Main 3-column workspace
             Sidebar | Chat thread | Unified inspector
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsWorkspaceRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="InspectorColumn" Width="420" />
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ──────────────────────────────────────────────── -->
            <views:WorkspaceSidebarView Grid.Column="0" />

            <!-- Sidebar resize splitter -->
            <Grid Grid.Column="1" Background="Transparent"
                  ToolTipService.ToolTip="拖动调整侧栏宽度">
                <Rectangle Width="1"
                           Fill="{ThemeResource ReadOSBorderBrush}"
                           HorizontalAlignment="Center" />
                <primitives:Thumb Width="16"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  DragDelta="SidebarSplitter_DragDelta" />
            </Grid>

            <!-- ── Chat thread ──────────────────────────────────────────── -->
            <views:ChatSurfaceView x:Name="ChatSurface"
                                   Grid.Column="2"
                                   Margin="0" />

            <!-- Inspector resize splitter -->
            <Grid Grid.Column="3"
                  x:Name="InspectorSplitterGrid"
                  Background="Transparent"
                  ToolTipService.ToolTip="拖动调整审查面板宽度">
                <Rectangle Width="1"
                           Fill="{ThemeResource ReadOSBorderBrush}"
                           HorizontalAlignment="Center" />
                <primitives:Thumb Width="16"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  DragDelta="InspectorSplitter_DragDelta" />
            </Grid>

            <!-- ── Unified inspector ── -->
            <views:InspectorView Grid.Column="4"
                                 x:Name="InspectorSurface"
                                 Visibility="{Binding IsInspectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- ── Settings route (replaces workspace when active) ──────────── -->
        <views:SettingsView Grid.Row="1"
                            Visibility="{Binding IsSettingsRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- ═══════════════════════════════════════════════════════════════
             Row 2 — Status bar (28 px)
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{ThemeResource ReadOSCanvasBrush}"
                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                           FontSize="{StaticResource FontSizeXs}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ActiveModelLabel}"
                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                           FontSize="{StaticResource FontSizeXs}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <ProgressRing Grid.Column="2"
                              Width="16" Height="16"
                              IsActive="{Binding IsBusy}"
                              Margin="8,0,0,0"
                              VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
