<Window
    x:Class="ReadOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:ReadOS.App.Views"
    mc:Ignorable="d"
    Title="ReadOS">

    <Grid x:Name="RootShell" Background="{ThemeResource ReadOSCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 0 — Codex-native global toolbar
             Global actions, active thread, runtime state, and transient status.
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Style="{StaticResource ReadOSTopBarStyle}">
            <Grid Padding="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: brand + compact global actions -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Border Width="28" Height="28"
                            CornerRadius="{StaticResource RadiusLg}"
                            Background="{ThemeResource ReadOSBrandBrush}">
                        <TextBlock Text="R"
                                   Foreground="{ThemeResource ReadOSBrandTextBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Visual separator -->
                    <Border Width="1" Height="18"
                            Background="{ThemeResource ReadOSBorderBrush}"
                            Margin="6,0,4,0" />

                    <!-- Import -->
                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="导入资料"
                            Command="{Binding ImportMaterialCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE8E5;"
                                  FontSize="13" />
                    </Button>

                    <!-- New thread -->
                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="新建线程"
                            Command="{Binding NewConversationCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE710;"
                                  FontSize="13" />
                    </Button>

                    <!-- Theme toggle -->
                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="{Binding ThemeToggleLabel}"
                            Command="{Binding ToggleThemeCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE706;"
                                  FontSize="13" />
                    </Button>

                    <!-- Settings -->
                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="设置"
                            Command="{Binding NavigateSettingsCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE713;"
                                  FontSize="13" />
                    </Button>

                    <!-- Run drawer -->
                    <Button Style="{StaticResource ReadOSIconButtonStyle}"
                            ToolTipService.ToolTip="运行抽屉"
                            Command="{Binding ToggleRunDrawerCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons"
                                  Glyph="&#xE756;"
                                  FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- Drag region: active thread + runtime context -->
                <Grid Grid.Column="1"
                      x:Name="TitleBarDragRegion"
                      Background="Transparent">
                    <Grid ColumnSpacing="10"
                          Margin="12,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ReadOSChipStyle}"
                                Padding="6,3"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="5">
                                <Ellipse Width="5" Height="5"
                                         Fill="{ThemeResource ReadOSSuccessBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ActiveModelLabel}"
                                           Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ActiveTitle}"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="2"
                                Style="{StaticResource ReadOSChipStyle}"
                                Padding="6,3"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding RuntimeStatusLabel}"
                                       Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                   FontSize="{StaticResource FontSizeXs}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="3"
                                Height="28"
                                Padding="8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="{ThemeResource ReadOSAccentMutedBrush}"
                                BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                ToolTipService.ToolTip="打开待审批 MSP 命令"
                                Command="{Binding OpenPendingApprovalCommand}"
                                Visibility="{Binding HasPendingApprovals, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE7BA;"
                                          FontSize="11"
                                          Foreground="{ThemeResource ReadOSAccentBrush}" />
                                <TextBlock Text="{Binding PendingApprovalLabel}"
                                           Foreground="{ThemeResource ReadOSAccentBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 1 — Codex-native workspace
             Left rail/context | Thread workspace | Review dock
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsWorkspaceRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="324" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorSplitterColumn" Width="6" />
                <ColumnDefinition x:Name="InspectorColumn" Width="440" />
            </Grid.ColumnDefinitions>

            <!-- ── Sidebar ──────────────────────────────────────────────── -->
            <views:WorkspaceSidebarView Grid.Column="0" />

            <!-- Sidebar resize splitter -->
            <Grid Grid.Column="1" Background="Transparent"
                  ToolTipService.ToolTip="拖动调整侧栏宽度">
                <Rectangle Width="1"
                           Fill="{ThemeResource ReadOSBorderBrush}"
                           HorizontalAlignment="Center" />
                <primitives:Thumb Width="16"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  DragDelta="SidebarSplitter_DragDelta" />
            </Grid>

            <!-- ── Chat thread ──────────────────────────────────────────── -->
            <views:ChatSurfaceView x:Name="ChatSurface"
                                   Grid.Column="2"
                                   Margin="0" />

            <!-- Review dock resize splitter -->
            <Grid Grid.Column="3"
                  x:Name="InspectorSplitterGrid"
                  Background="Transparent"
                  ToolTipService.ToolTip="拖动调整 Review Dock 宽度">
                <Rectangle Width="1"
                           Fill="{ThemeResource ReadOSBorderBrush}"
                           HorizontalAlignment="Center" />
                <primitives:Thumb Width="16"
                                  HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  DragDelta="InspectorSplitter_DragDelta" />
            </Grid>

            <!-- ── Unified inspector ── -->
            <views:InspectorView Grid.Column="4"
                                 x:Name="InspectorSurface"
                                 Visibility="{Binding IsInspectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- ── Settings route (replaces workspace when active) ──────────── -->
        <views:SettingsView Grid.Row="1"
                            Visibility="{Binding IsSettingsRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- ═══════════════════════════════════════════════════════════════
             Row 2 — Bottom runtime drawer
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Height="{Binding RunDrawerHeight}"
                Style="{StaticResource ReadOSBottomDrawerStyle}"
                Visibility="{Binding IsRunDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ReadOSPaneToolbarStyle}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE756;"
                                      FontSize="13"
                                      Foreground="{ThemeResource ReadOSAccentBrush}" />
                            <TextBlock Text="Runtime"
                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MspActivitySummary}"
                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                    ToolTipService.ToolTip="停止当前命令"
                                    Command="{Binding CancelActiveMspCommandCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE711;"
                                          FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                    ToolTipService.ToolTip="固定运行抽屉"
                                    Command="{Binding PinRunDrawerCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE840;"
                                          FontSize="12" />
                            </Button>
                            <Button Style="{StaticResource ReadOSIconButtonStyle}"
                                    ToolTipService.ToolTip="关闭运行抽屉"
                                    Command="{Binding ToggleRunDrawerCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE711;"
                                          FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding MspTranscript}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="8"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="10"
                                    Style="{StaticResource ReadOSCardStyle}">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       Foreground="{ThemeResource ReadOSAccentBrush}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding CommandText}"
                                                       Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding OutputPreview}"
                                                   Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                   FontFamily="Consolas"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   MaxLines="3" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <Button Height="28" Padding="8,0"
                                                Visibility="{Binding IsApprovalRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.ApproveMspCommandCommand, ElementName=RootShell}"
                                                CommandParameter="{Binding}"
                                                Content="批准" />
                                        <Button Height="28" Padding="8,0"
                                                Visibility="{Binding IsApprovalRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.DenyMspCommandCommand, ElementName=RootShell}"
                                                CommandParameter="{Binding}"
                                                Content="拒绝" />
                                        <Button Height="28" Padding="8,0"
                                                Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.CancelMspCommandCommand, ElementName=RootShell}"
                                                CommandParameter="{Binding}"
                                                Content="取消" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

    </Grid>
</Window>
