                    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#1F2328" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ReadOSCanvasBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ReadOSChromeBrush" Color="#171717" />
                    <SolidColorBrush x:Key="ReadOSSidebarBrush" Color="#171717" />
                    <SolidColorBrush x:Key="ReadOSPanelBrush" Color="#171717" />
                    <SolidColorBrush x:Key="ReadOSSubtleBrush" Color="#262626" />
                    <SolidColorBrush x:Key="ReadOSRaisedBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="ReadOSElevatedBrush" Color="#242424" />
                    <SolidColorBrush x:Key="ReadOSBorderBrush" Color="#303030" />
                    <SolidColorBrush x:Key="ReadOSStrongBorderBrush" Color="#414141" />
                    <SolidColorBrush x:Key="ReadOSHairlineBrush" Color="#262626" />
                    <SolidColorBrush x:Key="ReadOSListHoverBrush" Color="#262626" />
                    <SolidColorBrush x:Key="ReadOSListSelectedBrush" Color="#102B42" />
                    <SolidColorBrush x:Key="ReadOSButtonBrush" Color="#242424" />
                    <SolidColorBrush x:Key="ReadOSButtonHoverBrush" Color="#303030" />
                    <SolidColorBrush x:Key="ReadOSButtonPressedBrush" Color="#383838" />
                    <SolidColorBrush x:Key="ReadOSButtonBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ReadOSTextPrimaryBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="ReadOSTextSecondaryBrush" Color="#C7C7C7" />
                    <SolidColorBrush x:Key="ReadOSTextTertiaryBrush" Color="#A1A1AA" />
                    <SolidColorBrush x:Key="ReadOSBrandBrush" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="ReadOSBrandTextBrush" Color="#111111" />
                    <SolidColorBrush x:Key="ReadOSAccentBrush" Color="#4DA3FF" />
                    <SolidColorBrush x:Key="ReadOSAccentTextBrush" Color="#0D0D0D" />
                    <SolidColorBrush x:Key="ReadOSAccentMutedBrush" Color="#0F2A43" />
                    <SolidColorBrush x:Key="ReadOSPrimaryButtonHoverBrush" Color="#69B4FF" />
                    <SolidColorBrush x:Key="ReadOSPrimaryButtonPressedBrush" Color="#2F91F2" />
                    <SolidColorBrush x:Key="ReadOSSuccessBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="ReadOSWarningBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="ReadOSDangerBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="ReadOSPdfPageHostBrush" Color="#252B34" />
                    <SolidColorBrush x:Key="ReadOSSplitterHoverBrush" Color="#6B7280" />

                    <SolidColorBrush x:Key="ButtonBackground" Color="#242424" />
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#303030" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#383838" />
                    <SolidColorBrush x:Key="ButtonForeground" Color="#F4F4F5" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#3A3A3A" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#525252" />
                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#5F5F5F" />
