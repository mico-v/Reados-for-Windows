<UserControl
    x:Class="ReadOS.App.Controls.SplitPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
            <ColumnDefinition x:Name="SplitterColumn" Width="0" />
            <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <ContentPresenter Grid.Column="0"
                          x:Name="PrimaryPresenter"
                          Content="{x:Bind PrimaryContent, Mode=OneWay}" />

        <Grid Grid.Column="1" x:Name="SplitterGrid" Background="Transparent">
            <Rectangle Width="1"
                       Fill="{ThemeResource ReadOSBorderBrush}"
                       HorizontalAlignment="Center" />
            <primitives:Thumb Width="10"
                              HorizontalAlignment="Center"
                              Background="Transparent"
                              DragDelta="SplitterThumb_DragDelta" />
        </Grid>

        <ContentPresenter Grid.Column="2"
                          x:Name="SecondaryPresenter"
                          Content="{x:Bind SecondaryContent, Mode=OneWay}" />
    </Grid>
</UserControl>
