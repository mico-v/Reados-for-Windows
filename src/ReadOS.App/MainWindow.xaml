<Window
    x:Class="ReadOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:views="using:ReadOS.App.Views"
    mc:Ignorable="d"
    Title="ReadOS">

    <Grid x:Name="RootShell" Background="{ThemeResource ReadOSCanvasBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Padding="12,0,150,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7" Background="{ThemeResource ReadOSBrandBrush}">
                        <TextBlock Text="R" Foreground="{ThemeResource ReadOSBrandTextBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="ReadOS" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WorkspaceModeLabel}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="TitleBarDragRegion" Grid.Column="1" Background="Transparent">
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTitle}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActiveWorkspaceScope}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="导入资料" Command="{Binding ImportMaterialCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8E5;" FontSize="14" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="新对话" Command="{Binding NewConversationCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE710;" FontSize="14" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="{Binding ThemeToggleLabel}" Command="{Binding ToggleThemeCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE706;" FontSize="14" />
                    </Button>
                    <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="设置" Command="{Binding NavigateSettingsCommand}">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Visibility="{Binding IsWorkspaceRoute, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:WorkspaceSidebarView Grid.Column="0" />

            <Grid Grid.Column="1" Background="Transparent">
                <Rectangle Width="1" Fill="{ThemeResource ReadOSBorderBrush}" HorizontalAlignment="Center" />
                <primitives:Thumb Width="12" HorizontalAlignment="Center" Background="Transparent" DragDelta="SidebarResizeThumb_DragDelta" />
            </Grid>

            <Grid Grid.Column="2" Padding="10" Background="{ThemeResource ReadOSCanvasBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ChatColumn" Width="*" />
                    <ColumnDefinition x:Name="PresenterSplitterColumn" Width="1" />
                    <ColumnDefinition x:Name="PresenterColumn" Width="520" />
                </Grid.ColumnDefinitions>

                <views:ChatSurfaceView x:Name="ChatSurface"
                                       Grid.Column="0"
                                       Visibility="{Binding IsChatWorkspaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid Grid.Column="1" Background="Transparent">
                    <Rectangle Width="1" Fill="{ThemeResource ReadOSBorderBrush}" HorizontalAlignment="Center" />
                    <primitives:Thumb Width="12" HorizontalAlignment="Center" Background="Transparent" DragDelta="WorkspaceSurfaceResizeThumb_DragDelta" />
                </Grid>

                <views:PresenterSurfaceView x:Name="PresenterSurface"
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding IsPresenterVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <views:SettingsView Grid.Row="1" Visibility="{Binding IsSettingsRoute, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border Grid.Row="2" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="12,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
                <ProgressRing Grid.Column="1" Width="18" Height="18" IsActive="{Binding IsBusy}" />
            </Grid>
        </Border>
    </Grid>
</Window>
