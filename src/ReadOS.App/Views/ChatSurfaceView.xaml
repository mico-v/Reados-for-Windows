<UserControl
    x:Class="ReadOS.App.Views.ChatSurfaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d">

    <Border Background="{ThemeResource ReadOSCanvasBrush}"
            BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="14,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTitle}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding ActiveWorkspaceScope}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="·" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                            <TextBlock Text="{Binding PendingAttachmentSummary}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border MinWidth="118" Height="32" Padding="9,0" CornerRadius="8" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="{ThemeResource ReadOSSuccessBrush}" />
                                <TextBlock Text="{Binding ActiveModelLabel}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="显示侧栏" Click="RestoreSidebarButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE700;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="显示审查面板" Click="RestoreInspectorButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A0;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="对话优先" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="ChatPrimary">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A9;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="打开证据预览" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="PresenterPrimary">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="13" />
                        </Button>
                        <Button Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="专注对话" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="FocusChat">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE740;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="InspectorSplitterColumn" Width="1" />
                    <ColumnDefinition x:Name="InspectorColumn" Width="316" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="172" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" Padding="20,16">
                        <ItemsControl ItemsSource="{Binding ChatMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,12" Padding="14" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="8" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BD;" FontSize="12" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Author}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                                    <TextBlock Text="线程消息" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Timestamp}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Attachments}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,6" Padding="9" CornerRadius="8" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                            <Grid ColumnSpacing="8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource ReadOSAccentBrush}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Spacing="1">
                                                                    <TextBlock Text="{Binding Title}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Content}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextWrapping="WrapWholeWords" LineHeight="21" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border Grid.Row="1" Margin="16,0,16,16" Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSCanvasBrush}" BorderBrush="{ThemeResource ReadOSStrongBorderBrush}" BorderThickness="1">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="36" />
                            </Grid.RowDefinitions>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PendingAttachmentSummary}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                    <TextBlock Text="{Binding WorkspaceModeLabel}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="清空附件" Command="{Binding ClearAttachmentsCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE74D;" FontSize="12" />
                                </Button>
                            </Grid>
                            <TextBox Grid.Row="1"
                                     MinHeight="72"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     TextWrapping="Wrap"
                                     PlaceholderText="向 MSP Agent 发起任务..."
                                     Text="{Binding ComposerDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Grid Grid.Row="2" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="附加当前页或全文" Command="{Binding AttachCurrentPageCommand}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="13" />
                                    </Button>
                                    <Button Width="34" Height="34" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="框选证据" Command="{Binding StartRegionSelectionCommand}">
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xEF20;" FontSize="13" />
                                    </Button>
                                    <TextBox Width="132" Height="34" PlaceholderText="1-3, 8" Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Height="34" Padding="10,0" Background="Transparent" BorderThickness="0" Command="{Binding AttachRangeCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8A5;" FontSize="12" />
                                            <TextBlock Text="范围" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Button Grid.Column="1" Height="34" MinWidth="92" Padding="14,0" Background="{ThemeResource ReadOSAccentBrush}" Foreground="{ThemeResource ReadOSAccentTextBrush}" BorderThickness="0" Command="{Binding SendPromptCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="发送" FontWeight="SemiBold" />
                                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE724;" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" Background="Transparent">
                    <Rectangle Width="1" Fill="{ThemeResource ReadOSBorderBrush}" HorizontalAlignment="Center" />
                    <primitives:Thumb Width="12" HorizontalAlignment="Center" Background="Transparent" DragDelta="InspectorResizeThumb_DragDelta" />
                </Grid>

                <Border Grid.Column="2" Background="{ThemeResource ReadOSSidebarBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1,0,0,0">
                    <Grid Padding="12" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="32" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="运行审查" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ActiveModelLabel}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="隐藏审查面板" Command="{Binding ToggleChatCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE8BB;" FontSize="12" />
                            </Button>
                        </Grid>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ToggleButton Height="32" MinWidth="62" IsChecked="{Binding IsContextInspectorSelected, Mode=OneWay}" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Context" Content="上下文" />
                                <ToggleButton Height="32" MinWidth="62" IsChecked="{Binding IsActionsInspectorSelected, Mode=OneWay}" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Actions" Content="运行" />
                                <ToggleButton Height="32" MinWidth="62" IsChecked="{Binding IsEvidenceInspectorSelected, Mode=OneWay}" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Evidence" Content="证据" />
                                <ToggleButton Height="32" MinWidth="62" IsChecked="{Binding IsAttachmentsInspectorSelected, Mode=OneWay}" Command="{Binding SelectInspectorTabCommand}" CommandParameter="Attachments" Content="附件" />
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="2">
                            <ScrollViewer Visibility="{Binding IsContextInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="当前对象" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ActiveTitle}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{Binding ActiveSubtitle}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" TextWrapping="WrapWholeWords" MaxLines="4" />
                                            <TextBox Header="名称" Text="{Binding DocumentNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Height="34" Command="{Binding RenameDocumentCommand}" Content="重命名" />
                                                <Button Grid.Column="1" Height="34" Command="{Binding DeleteDocumentCommand}" Content="删除" />
                                            </Grid>
                                            <Button Height="34" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Command="{Binding OpenLocationCommand}" Content="打开位置" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="工作区" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding ExportWorkspaceCommand}" Content="导出工作区" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding ImportWorkspaceCommand}" Content="导入工作区" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Visibility="{Binding IsActionsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="MSP 命令" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBox Header="exec_command" PlaceholderText="workspace info" Text="{Binding MspCommandDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Background="{ThemeResource ReadOSAccentBrush}" Foreground="{ThemeResource ReadOSAccentTextBrush}" BorderThickness="0" Command="{Binding RunMspCommandCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE756;" FontSize="12" />
                                                    <TextBlock Text="执行 MSP 命令" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <Grid RowSpacing="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Transcript" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding MspTranscriptSummary}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                            </StackPanel>
                                            <ListView Grid.Row="1" MaxHeight="260" ItemsSource="{Binding MspTranscript}" Background="Transparent" BorderThickness="0">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,8" Padding="9" CornerRadius="8" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                            <StackPanel Spacing="5">
                                                                <Grid ColumnSpacing="8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding CommandText}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding OutputPreview}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" MaxLines="8" />
                                                                <TextBlock Text="{Binding ArtifactsSummary}" Foreground="{ThemeResource ReadOSAccentBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Effects}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding IsApprovalRequired, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Button Height="28" Padding="10,0" Command="{Binding DataContext.ApproveMspCommandCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="11" />
                                                                            <TextBlock Text="批准并重放" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                    <Button Height="28" Padding="10,0" Background="Transparent" BorderBrush="{ThemeResource ReadOSBorderBrush}" Command="{Binding DataContext.DenyMspCommandCommand, ElementName=Root}" CommandParameter="{Binding}">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE711;" FontSize="11" />
                                                                            <TextBlock Text="拒绝" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="任务状态" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}" />
                                                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                            </Grid>
                                            <Border Padding="8" CornerRadius="8" Background="{ThemeResource ReadOSSubtleBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="策略" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                    <TextBlock Text="确认模式" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" TextWrapping="WrapWholeWords" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="线程" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding NewConversationCommand}" Content="新建线程" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding ClearConversationCommand}" Content="清空当前线程" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="布局" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Button Height="34" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="ChatPrimary" Content="对话 + 审查" />
                                            <Button Height="34" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="PresenterPrimary" Content="对话 + 证据预览" />
                                            <Button Height="34" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="FocusChat" Content="专注对话" />
                                            <Button Height="34" Command="{Binding SetWorkspaceLayoutCommand}" CommandParameter="FocusPresenter" Content="专注预览" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Visibility="{Binding IsEvidenceInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="上下文摘要" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ActiveWorkspaceScope}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                            <TextBlock Text="{Binding PendingAttachmentSummary}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="模型" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ActiveModelLabel}" Foreground="{ThemeResource ReadOSTextSecondaryBrush}" TextWrapping="WrapWholeWords" />
                                            <Button Height="34" HorizontalAlignment="Stretch" Command="{Binding NavigateSettingsCommand}" Content="模型设置" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="文档搜索" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <TextBox Height="34" PlaceholderText="搜索当前文档" Text="{Binding DocumentSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Height="34" Command="{Binding SearchInDocumentCommand}" Content="搜索" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <ScrollViewer Visibility="{Binding IsAttachmentsInspectorSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Spacing="12">
                                    <Border Padding="12" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="待发送证据" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontWeight="SemiBold" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Height="34" Command="{Binding AttachCurrentPageCommand}" Content="本页/全文" />
                                                <Button Grid.Column="1" Height="34" Command="{Binding StartRegionSelectionCommand}" Content="框选" />
                                            </Grid>
                                            <TextBox Height="34" PlaceholderText="1-3, 8" Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button Height="34" Command="{Binding AttachRangeCommand}" Content="附加范围" />
                                                <Button Grid.Column="1" Height="34" Command="{Binding ClearAttachmentsCommand}" Content="清空" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding PendingAttachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" Padding="10" CornerRadius="8" Background="{ThemeResource ReadOSRaisedBrush}" BorderBrush="{ThemeResource ReadOSBorderBrush}" BorderThickness="1">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Title}" Foreground="{ThemeResource ReadOSTextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{ThemeResource ReadOSTextTertiaryBrush}" FontSize="12" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
