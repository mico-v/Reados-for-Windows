<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>MspFfi</AssemblyName>
    <RootNamespace>MspFfi</RootNamespace>
    <PackageId>MspFfi</PackageId>
    <Version>0.1.0</Version>
    <Authors>ReadOS</Authors>
    <Description>Small ownership-safe .NET binding for the virtual-only msp_ffi C ABI.</Description>
    <PackageTags>MSP;FFI;native;virtual-workspace;SafeHandle</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mico-v/reados</RepositoryUrl>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\..\..\include\msp_ffi.h" Pack="true" PackagePath="build\native\msp_ffi.h" />
  </ItemGroup>

  <!--
    Native assets are deliberately opt-in. A package build never searches the
    repository for a DLL. Supply both MspFfiNativeLibraryPath and
    RuntimeIdentifier when a package should carry one explicit native binary.
  -->
  <ItemGroup Condition="'$(MspFfiNativeLibraryPath)' != ''">
    <None Include="$(MspFfiNativeLibraryPath)"
          Pack="true"
          PackagePath="runtimes\$(RuntimeIdentifier)\native\msp_ffi.dll" />
  </ItemGroup>

  <Target Name="ValidateExplicitMspFfiNativeLibrary" BeforeTargets="Pack"
          Condition="'$(MspFfiNativeLibraryPath)' != ''">
    <Error Condition="'$(RuntimeIdentifier)' == ''"
           Text="RuntimeIdentifier must be supplied with MspFfiNativeLibraryPath." />
    <Error Condition="!Exists('$(MspFfiNativeLibraryPath)')"
           Text="MspFfiNativeLibraryPath does not exist: $(MspFfiNativeLibraryPath)" />
  </Target>
</Project>
