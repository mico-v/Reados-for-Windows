<UserControl
    x:Class="ReadOS.App.Views.ChatSurfaceView"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border DataContext="{Binding Thread}"
            Background="{ThemeResource ReadOSCanvasBrush}"
            BorderBrush="{ThemeResource ReadOSBorderBrush}"
            BorderThickness="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── Thread header ──────────────────────────────────────────── -->
            <Border Background="{ThemeResource ReadOSCanvasBrush}"
                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,0">
                <Grid ColumnSpacing="{StaticResource SpacingMd}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveTitle}"
                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                   FontSize="{StaticResource FontSizeMd}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                            <TextBlock Text="{Binding ActiveWorkspaceScope}"
                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="·"
                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                       FontSize="{StaticResource FontSizeXs}" />
                            <TextBlock Text="{Binding PendingAttachmentSummary}"
                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                       FontSize="{StaticResource FontSizeXs}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <!-- Restore sidebar button -->
                        <Button Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="6"
                                ToolTipService.ToolTip="显示侧栏"
                                Click="RestoreSidebarButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE700;"
                                      FontSize="12" />
                        </Button>
                        <!-- Restore inspector button -->
                        <Button Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                CornerRadius="6"
                                ToolTipService.ToolTip="显示审查面板"
                                Click="RestoreInspectorButton_Click">
                            <FontIcon FontFamily="Segoe Fluent Icons"
                                      Glyph="&#xE76B;"
                                      FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Thread body ────────────────────────────────────────────── -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Messages scroll -->
                <ScrollViewer Grid.Row="0" Padding="20,14">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12"
                                        Padding="14"
                                        CornerRadius="{StaticResource RadiusLg}"
                                        Background="{ThemeResource ReadOSRaisedBrush}"
                                        BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                        BorderThickness="1">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28"
                                                    CornerRadius="{StaticResource RadiusLg}"
                                                    Background="{ThemeResource ReadOSSubtleBrush}"
                                                    BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                    BorderThickness="1">
                                                <FontIcon FontFamily="Segoe Fluent Icons"
                                                          Glyph="&#xE8BD;"
                                                          FontSize="{StaticResource IconSizeSm}"
                                                          Foreground="{ThemeResource ReadOSTextSecondaryBrush}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Author}"
                                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="线程消息"
                                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                           FontSize="{StaticResource FontSizeXs}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Timestamp}"
                                                       Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                       FontSize="{StaticResource FontSizeSm}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Attachments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,6"
                                                            Padding="9"
                                                            CornerRadius="{StaticResource RadiusLg}"
                                                            Background="{ThemeResource ReadOSSubtleBrush}"
                                                            BorderBrush="{ThemeResource ReadOSBorderBrush}"
                                                            BorderThickness="1">
                                                        <Grid ColumnSpacing="{StaticResource SpacingSm}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <FontIcon FontFamily="Segoe Fluent Icons"
                                                                      Glyph="&#xE8A5;"
                                                                      FontSize="{StaticResource IconSizeSm}"
                                                                      Foreground="{ThemeResource ReadOSAccentBrush}"
                                                                      VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" Spacing="1">
                                                                <TextBlock Text="{Binding Title}"
                                                                           Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                                           FontSize="{StaticResource FontSizeSm}"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Detail}"
                                                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                                                           FontSize="{StaticResource FontSizeSm}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Content}"
                                                   Foreground="{ThemeResource ReadOSTextPrimaryBrush}"
                                                   TextWrapping="WrapWholeWords"
                                                   LineHeight="21" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- ── Composer ─────────────────────────────────────────── -->
                <Border Grid.Row="1"
                        Margin="14,0,14,14"
                        Padding="12"
                        CornerRadius="{StaticResource RadiusLg}"
                        Background="{ThemeResource ReadOSCanvasBrush}"
                        BorderBrush="{ThemeResource ReadOSStrongBorderBrush}"
                        BorderThickness="1">
                    <Grid RowSpacing="{StaticResource SpacingSm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="{StaticResource SpacingSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{StaticResource SpacingSm}"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding PendingAttachmentSummary}"
                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                           FontSize="{StaticResource FontSizeSm}" />
                                <TextBlock Text="{Binding WorkspaceModeLabel}"
                                           Foreground="{ThemeResource ReadOSTextTertiaryBrush}"
                                           FontSize="{StaticResource FontSizeSm}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Width="28" Height="28" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    ToolTipService.ToolTip="清空附件"
                                    Command="{Binding ClearAttachmentsCommand}">
                                <FontIcon FontFamily="Segoe Fluent Icons"
                                          Glyph="&#xE74D;"
                                          FontSize="{StaticResource IconSizeSm}" />
                            </Button>
                        </Grid>
                        <TextBox Grid.Row="1"
                                 MinHeight="72"
                                 AcceptsReturn="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 TextWrapping="Wrap"
                                 PlaceholderText="向 MSP Agent 发起任务..."
                                 Text="{Binding ComposerDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Grid.Row="2" ColumnSpacing="{StaticResource SpacingSm}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                <Button Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="附加当前页或全文"
                                        Command="{Binding AttachCurrentPageCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE8A5;"
                                              FontSize="{StaticResource IconSizeSm}" />
                                </Button>
                                <Button Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTipService.ToolTip="框选证据"
                                        Command="{Binding StartRegionSelectionCommand}">
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xEF20;"
                                              FontSize="{StaticResource IconSizeSm}" />
                                </Button>
                                <TextBox Width="120" Height="32"
                                         PlaceholderText="1-3, 8"
                                         Text="{Binding PageRangeDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Height="32" Padding="10,0"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding AttachRangeCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingXs}">
                                        <FontIcon FontFamily="Segoe Fluent Icons"
                                                  Glyph="&#xE8A5;"
                                                  FontSize="{StaticResource IconSizeSm}" />
                                        <TextBlock Text="范围" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Height="32" MinWidth="84" Padding="12,0"
                                    Background="{ThemeResource ReadOSAccentBrush}"
                                    Foreground="{ThemeResource ReadOSAccentTextBrush}"
                                    BorderThickness="0"
                                    Command="{Binding SendPromptCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpacingSm}">
                                    <TextBlock Text="发送" FontWeight="SemiBold" />
                                    <FontIcon FontFamily="Segoe Fluent Icons"
                                              Glyph="&#xE724;"
                                              FontSize="{StaticResource IconSizeSm}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
