<Application
    x:Class="ReadOS.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:ReadOS.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ReadOSCanvasBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSSidebarBrush" Color="#F9F9F9" />
                    <SolidColorBrush x:Key="ReadOSSubtleBrush" Color="#F7F7F8" />
                    <SolidColorBrush x:Key="ReadOSBorderBrush" Color="#ECECEC" />
                    <SolidColorBrush x:Key="ReadOSStrongBorderBrush" Color="#DADCE0" />
                    <SolidColorBrush x:Key="ReadOSTextPrimaryBrush" Color="#0D0D0D" />
                    <SolidColorBrush x:Key="ReadOSTextSecondaryBrush" Color="#5F6368" />
                    <SolidColorBrush x:Key="ReadOSTextTertiaryBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="ReadOSBrandBrush" Color="#0D0D0D" />
                    <SolidColorBrush x:Key="ReadOSBrandTextBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ReadOSPdfPageHostBrush" Color="#D8D8D8" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ReadOSCanvasBrush" Color="#212121" />
                    <SolidColorBrush x:Key="ReadOSSidebarBrush" Color="#171717" />
                    <SolidColorBrush x:Key="ReadOSSubtleBrush" Color="#2A2A2A" />
                    <SolidColorBrush x:Key="ReadOSBorderBrush" Color="#333333" />
                    <SolidColorBrush x:Key="ReadOSStrongBorderBrush" Color="#424242" />
                    <SolidColorBrush x:Key="ReadOSTextPrimaryBrush" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="ReadOSTextSecondaryBrush" Color="#C7C7C7" />
                    <SolidColorBrush x:Key="ReadOSTextTertiaryBrush" Color="#9B9B9B" />
                    <SolidColorBrush x:Key="ReadOSBrandBrush" Color="#F4F4F4" />
                    <SolidColorBrush x:Key="ReadOSBrandTextBrush" Color="#171717" />
                    <SolidColorBrush x:Key="ReadOSPdfPageHostBrush" Color="#2F2F2F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
