<Window
    x:Class="ReadOS.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    mc:Ignorable="d"
    Title="ReadOS">

    <Grid x:Name="RootShell" Background="#111111">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1D1D1D" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <Grid Padding="12,0" ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Width="32" Height="32" Padding="0" Content="‹" FontSize="22" />
                    <Button Width="32" Height="32" Padding="0" Content="›" FontSize="22" />
                    <Button Width="32" Height="32" Padding="0" Content="↓" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
                    <TextBlock Text="文件" Foreground="#D6D6D6" FontSize="16" />
                    <TextBlock Text="编辑" Foreground="#9A9A9A" FontSize="16" />
                    <TextBlock Text="视图" Foreground="#9A9A9A" FontSize="16" />
                    <TextBlock Text="帮助" Foreground="#9A9A9A" FontSize="16" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Strings.AppSubtitle}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#777777" />

                <Button Grid.Column="3"
                        Content="{Binding Strings.OpenLocation}"
                        Padding="14,6"
                        Command="{Binding OpenSettingsCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="320" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#1C1C1C">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Padding="12,16,12,12" Spacing="8">
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Content="{Binding Strings.NewSession}"
                            Command="{Binding StartSessionCommand}" />
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,8"
                            Content="{Binding Strings.ImportMaterial}"
                            Command="{Binding ImportMaterialCommand}" />
                    <TextBox Header="{Binding Strings.Search}"
                             PlaceholderText="{Binding Strings.SearchPlaceholder}"
                             Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1">
                    <StackPanel Padding="12,4,12,12" Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.Projects}"
                                       Foreground="#818181"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Content="+"
                                    Command="{Binding CreateProjectCommand}" />
                        </Grid>

                        <ListView ItemsSource="{Binding NavigationEntries}"
                                  SelectedItem="{Binding SelectedNavigationEntry, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,7" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Prefix}" Foreground="#AAAAAA" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="#E7E7E7" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding TimeLabel}"
                                                   Foreground="#858585"
                                                   FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <Button Grid.Row="2"
                        Margin="12,10,12,16"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="12,8"
                        Content="{Binding Strings.Settings}"
                        Command="{Binding OpenSettingsCommand}" />
            </Grid>

            <Border Grid.Column="1" Background="#303030">
                <primitives:Thumb Width="8"
                                  HorizontalAlignment="Center"
                                  Background="Transparent"
                                  DragDelta="SidebarResizeThumb_DragDelta" />
            </Border>

            <Grid Grid.Column="2" Background="#121212">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="150" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                    <Grid Padding="26,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding ActiveTitle}" Foreground="#F2F2F2" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="..." Foreground="#858585" FontSize="18" />
                            </StackPanel>
                            <TextBlock Text="{Binding ActiveSubtitle}" Foreground="#818181" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="{Binding Strings.OpenLocation}" Padding="14,6" />
                            <Button Content="{Binding Strings.Review}" Padding="14,6" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding ActivityStream}"
                                  MaxWidth="1120"
                                  HorizontalAlignment="Center"
                                  Margin="0,24,0,24">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,18"
                                        Padding="18"
                                        CornerRadius="8"
                                        BorderBrush="#343434"
                                        BorderThickness="1"
                                        Background="#202020">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="8"
                                                Background="#101010">
                                            <TextBlock Text="□"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#BEBEBE"
                                                       FontSize="18" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" Foreground="#F0F0F0" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Subtitle}" Foreground="#A0A0A0" FontSize="12" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Body}"
                                                       Foreground="#D8D8D8"
                                                       TextWrapping="WrapWholeWords"
                                                       FontSize="14" />

                                            <ItemsControl ItemsSource="{Binding Materials}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="0,8" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="42" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Width="38" Height="38" CornerRadius="7" Background="#111111">
                                                                <TextBlock Text="{Binding KindLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="#CCCCCC" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" Foreground="#F0F0F0" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Detail}" Foreground="#9B9B9B" FontSize="12" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Content="打开方式" Padding="12,5" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ItemsControl ItemsSource="{Binding FileChanges}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="0,5" ColumnSpacing="12">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Path}" Foreground="#E0E0E0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding DeltaText}" Foreground="#49D17D" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Badge}"
                                                   Foreground="#D8D8D8" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2" Padding="0,0,0,22">
                    <Border MaxWidth="1120"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            CornerRadius="20"
                            Background="#2A2A2A"
                            BorderBrush="#303030"
                            BorderThickness="1"
                            Padding="18,14">
                        <Grid RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBox PlaceholderText="{Binding Strings.ComposerPlaceholder}"
                                     Text="{Binding ComposerDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     MinHeight="58" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Width="34" Height="34" Padding="0" Content="+" Command="{Binding ImportMaterialCommand}" />
                                <TextBlock Grid.Column="1"
                                           Margin="14,0,0,0"
                                           Text="{Binding Strings.FullAccess}"
                                           Foreground="#FF8B3D"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding ActiveModelLabel}"
                                           Foreground="#CFCFCF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,14,0" />
                                <Button Grid.Column="4"
                                        Width="38"
                                        Height="38"
                                        Padding="0"
                                        Content="↑"
                                        Command="{Binding SendPromptCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Border>

                <Border Width="460"
                        HorizontalAlignment="Right"
                        Background="#1E1E1E"
                        BorderBrush="#303030"
                        BorderThickness="1,0,0,0"
                        Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Padding="20" RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Strings.Settings}" FontSize="24" FontWeight="SemiBold" Foreground="#F1F1F1" />
                            <Button Grid.Column="1" Content="{Binding Strings.CloseSettings}" Command="{Binding CloseSettingsCommand}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1">
                            <StackPanel Spacing="16">
                                <ComboBox Header="{Binding Strings.Language}"
                                          ItemsSource="{Binding LanguageOptions}"
                                          SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalAlignment="Stretch" />

                                <TextBox Header="{Binding Strings.ProviderName}" Text="{Binding ProviderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="{Binding Strings.BaseUrl}" Text="{Binding ProviderBaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="{Binding Strings.ApiKey}" Text="{Binding ProviderApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Header="{Binding Strings.ModelName}" Text="{Binding ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ToggleSwitch Header="{Binding Strings.UseMockResponses}" IsOn="{Binding UseMockResponses, Mode=TwoWay}" />
                                <TextBox Header="{Binding Strings.AttachmentPrompt}" Text="{Binding AttachmentDefaultPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" />
                                <TextBox Header="{Binding Strings.RegionPrompt}" Text="{Binding RegionExplainPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" />
                                <TextBox Header="{Binding Strings.ChapterPrompt}" Text="{Binding ChapterExplainPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="64" />
                                <TextBox Header="{Binding Strings.MinorUEndpoint}" Text="{Binding MinorUEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </ScrollViewer>

                        <Button Grid.Row="2" Content="{Binding Strings.SaveSettings}" HorizontalAlignment="Stretch" Command="{Binding SaveSettingsCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
